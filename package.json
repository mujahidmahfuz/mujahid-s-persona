{
  "name": "muja-research-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/todos.ts --list && astro build && node scripts/cv-pdf.mjs && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "guard": "node scripts/guard.mjs",
    "check": "astro check && tsc --noEmit && npm run lint && npm run test:unit && astro sync && node scripts/guard.mjs && npm run build && node scripts/guard.mjs --dist && node scripts/linkcheck.mjs",
    "test:e2e": "playwright test",
    "sync:pubs": "node scripts/sync.ts",
    "todos": "node scripts/todos.ts --list",
    "posters": "node scripts/posters.ts",
    "test:unit": "node --test \"src/explainers/**/*.test.ts\""
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.2",
    "@astrojs/react": "^7.1.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.4",
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "katex": "^0.19.1",
    "react": "~19.3",
    "react-dom": "~19.3",
    "tailwindcss": "^4.3.3",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "pagefind": "^1.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "~6.0",
    "typescript-eslint": "^8.72.1",
    "yaml": "^2.9.1"
  }
}
