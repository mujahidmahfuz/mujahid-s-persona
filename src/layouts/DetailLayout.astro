---
/**
 * Detail page shell (research, projects), laid out like a product page:
 * a dark full-width opening plate (title, status, calls to action, the hero object), an optional
 * band under it, a sticky sub-navigation strip, the epigraph, then the numbered long-form column.
 */
import BaseLayout from './BaseLayout.astro';
import SubNav from '~/components/SubNav.astro';
import Epigraph from '~/components/Epigraph.astro';
import type { Chapter } from '~/lib/chapters';
import type { Treatment } from '~/data/epigraphs';

interface Props {
  title: string;
  description?: string;
  toc: { id: string; label: string }[];
  type?: 'website' | 'article' | 'profile';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  ogImage?: string;
  chapter?: Chapter;
  /** epigraph registry key, e.g. "research/<id>" */
  epigraph: string;
  epigraphTreatment?: Treatment;
}
const { toc, chapter, epigraph, epigraphTreatment = 'verse', ...rest } = Astro.props;
---

<BaseLayout {...rest}>
  <div data-chapter={chapter}>
    <div class="hero-plate relative overflow-hidden" data-surface="dark" data-tilt-zone>
      <span class="absolute inset-x-0 top-0 h-1 bg-[var(--accent)]" aria-hidden="true"></span>
      <div class="container-site py-14 md:py-20 lg:py-24">
        <slot name="header" />
      </div>
    </div>
    <slot name="band" />
    <SubNav items={toc} title={rest.title} />
    <div class="container-site pt-12">
      <Epigraph page={epigraph} treatment={epigraphTreatment} />
    </div>
    <div class="container-site py-12">
      <div class="atlas-article min-w-0">
        <slot />
      </div>
    </div>
  </div>
</BaseLayout>

<style is:global>
  .atlas-article {
    counter-reset: atlas-sec;
  }
  .atlas-article h2[id] {
    counter-increment: atlas-sec;
    /* clear the site header (4rem) and the sub-nav strip (~3.2rem) when jumped to */
    scroll-margin-top: 8.5rem;
  }
  .atlas-article h2[id]::before {
    content: '§' counter(atlas-sec);
    display: block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    color: var(--accent-ink, var(--color-terracotta-ink));
    margin-bottom: 0.35rem;
  }
</style>
