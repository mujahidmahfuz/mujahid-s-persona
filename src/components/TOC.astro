---
/** Sticky table of contents on ≥1024px; collapsible <details> on mobile (SPEC §4). No JS. */
interface Props {
  items: { id: string; label: string }[];
}
const { items } = Astro.props;
---

<nav aria-label="On this page" class="text-sm lg:sticky lg:top-24" data-pagefind-ignore="all">
  <details class="rounded-card border border-blue-200 bg-blue-050 p-4 lg:hidden">
    <summary class="cursor-pointer font-semibold text-blue">On this page</summary>
    <ol class="mt-3 space-y-2">
      {items.map((i) => (
        <li>
          <a href={`#${i.id}`}>{i.label}</a>
        </li>
      ))}
    </ol>
  </details>
  <div class="hidden lg:block">
    <p class="font-semibold text-blue">On this page</p>
    <ol class="mt-3 space-y-2 border-l-2 border-blue-200">
      {items.map((i) => (
        <li>
          <a
            href={`#${i.id}`}
            class="-ml-0.5 block border-l-2 border-transparent pl-3 text-muted no-underline hover:border-pink hover:text-blue"
          >
            {i.label}
          </a>
        </li>
      ))}
    </ol>
  </div>
</nav>
