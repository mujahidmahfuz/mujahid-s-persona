---
/**
 * A slowly scrolling band of research topics (constant motion → linear). Pauses on hover/focus.
 * Reduced motion: static and wrapped. The duplicate copy (for a seamless loop) is hidden from AT.
 */
import { topicPath } from '~/lib/paths';

interface Props {
  tags: string[];
}
const { tags } = Astro.props;
---

<div class="marquee relative overflow-hidden border-y border-white/15 bg-blue-900 py-3" data-surface="blue" aria-label="Topics">
  <div class="marquee-track flex w-max gap-3">
    {[0, 1].map((copy) => (
      <ul class="flex shrink-0 gap-3" aria-hidden={copy === 1 ? 'true' : undefined}>
        {tags.map((t) => (
          <li>
            <a
              href={topicPath(t)}
              tabindex={copy === 1 ? -1 : undefined}
              class="inline-flex rounded-chip border border-white/30 px-3 py-1 text-sm whitespace-nowrap no-underline hover:border-pink"
            >
              #{t}
            </a>
          </li>
        ))}
      </ul>
    ))}
  </div>
</div>

<style>
  .marquee-track {
    animation: marquee 70s linear infinite;
  }
  @keyframes marquee {
    to {
      transform: translateX(calc(-50% - 0.375rem));
    }
  }
  .marquee:hover .marquee-track,
  .marquee:focus-within .marquee-track {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .marquee-track {
      animation: none;
      width: auto;
      flex-wrap: wrap;
      padding-inline: 1rem;
    }
    .marquee-track > ul:last-child {
      display: none;
    }
    .marquee-track > ul {
      flex-wrap: wrap;
    }
  }
</style>
