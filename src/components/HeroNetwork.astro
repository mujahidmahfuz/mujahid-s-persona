---
/**
 * Hero decoration (DESIGN §3: "a pink node in a subtle animated network"). Decorative only, aria-hidden.
 * Motion: three layers drift a few px on long ease-in-out loops; two signals travel along edges
 * (offset-path, transform-composited). Reduced motion: completely still.
 * Deterministic layout so the server render never changes between builds.
 */
let h = 0x9e3779b9;
const rand = () => {
  h ^= h << 13;
  h ^= h >>> 17;
  h ^= h << 5;
  return ((h >>> 0) % 10000) / 10000;
};
type P = { x: number; y: number };
const layers = [0, 1, 2].map((layer) => {
  const pts: P[] = Array.from({ length: 9 }, () => ({ x: 30 + rand() * 540, y: 30 + rand() * 340 }));
  const edges: [number, number][] = [];
  pts.forEach((p, i) => {
    const near = pts
      .map((q, j) => ({ j, d: Math.hypot(p.x - q.x, p.y - q.y) }))
      .filter((o) => o.j !== i)
      .sort((a, b) => a.d - b.d)
      .slice(0, 2);
    for (const o of near) if (!edges.some(([a, b]) => (a === i && b === o.j) || (a === o.j && b === i))) edges.push([i, o.j]);
  });
  return { layer, pts, edges };
});
// Signals travel along two edges of the front layer.
const front = layers[0]!;
const sig = front.edges
  .slice(0, 2)
  .map(([a, b]) => `M${front.pts[a]!.x} ${front.pts[a]!.y} L${front.pts[b]!.x} ${front.pts[b]!.y}`);
const hub = front.pts[0]!;
---

<svg class="hero-net" viewBox="0 0 600 400" aria-hidden="true" focusable="false">
  {layers.map(({ layer, pts, edges }) => (
    <g class={`hero-layer hero-layer-${layer}`} opacity={layer === 0 ? 0.9 : layer === 1 ? 0.55 : 0.3}>
      {edges.map(([a, b]) => (
        <line
          x1={pts[a]!.x}
          y1={pts[a]!.y}
          x2={pts[b]!.x}
          y2={pts[b]!.y}
          stroke="#c7d3f0"
          stroke-opacity="0.45"
          stroke-width="1.2"
        />
      ))}
      {pts.map((p) => (
        <circle cx={p.x} cy={p.y} r={layer === 0 ? 4 : 3} fill="#ffffff" />
      ))}
    </g>
  ))}
  <g class="hero-layer hero-layer-0">
    <circle
      class="hero-hub-ring"
      cx={hub.x}
      cy={hub.y}
      r="9"
      fill="none"
      stroke="#fd91cc"
      stroke-width="2"
      style={`transform-origin:${hub.x}px ${hub.y}px`}
    ></circle>
    <circle cx={hub.x} cy={hub.y} r="7" fill="#fd91cc"></circle>
    {sig.map((d, i) => (
      <circle class="hero-signal" r="3.5" fill="#fd91cc" style={`offset-path:path('${d}');animation-delay:${i * 1.7}s`} />
    ))}
  </g>
</svg>

<style>
  .hero-net {
    width: 100%;
    height: 100%;
  }
  .hero-layer {
    animation: hero-drift 14s ease-in-out infinite alternate;
  }
  .hero-layer-1 {
    animation-duration: 18s;
    animation-direction: alternate-reverse;
  }
  .hero-layer-2 {
    animation-duration: 22s;
  }
  @keyframes hero-drift {
    from {
      transform: translate(0, 0);
    }
    to {
      transform: translate(10px, -8px);
    }
  }
  .hero-hub-ring {
    animation: hero-pulse 3.2s ease-out infinite;
  }
  @keyframes hero-pulse {
    from {
      transform: scale(0.9);
      opacity: 0.9;
    }
    to {
      transform: scale(2.2);
      opacity: 0;
    }
  }
  .hero-signal {
    offset-rotate: 0deg;
    animation: hero-signal 3.4s linear infinite;
    opacity: 0;
  }
  @keyframes hero-signal {
    0% {
      offset-distance: 0%;
      opacity: 0;
    }
    15%,
    85% {
      opacity: 1;
    }
    100% {
      offset-distance: 100%;
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-layer,
    .hero-hub-ring,
    .hero-signal {
      animation: none;
    }
    .hero-signal {
      opacity: 0;
    }
  }
</style>
