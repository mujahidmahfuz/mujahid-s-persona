---
/**
 * Animated process flow, used in MDX: <Flow title="…" source="…" steps={[{ label, detail, fan? }]} />.
 * Every step must come from the cited source (README, paper, code). Purpose: explanation.
 * Motion: a highlight walks the steps in order (CSS only); steps with `fan` show n parallel
 * workers pulsing; connectors flow. Pauses on hover/focus; static under reduced motion.
 */
interface Step {
  label: string;
  detail?: string;
  fan?: number;
}
interface Props {
  title: string;
  steps: Step[];
  source: string;
  /** documented = taken from the project's own docs/code; conceptual = an outline of an idea or plan */
  kind?: 'documented' | 'conceptual';
}
const { title, steps, source, kind = 'documented' } = Astro.props;
const n = steps.length;
---

<figure class="flow my-10 rounded-card border border-blue-200 bg-blue-050 p-5 md:p-6" data-flow data-reveal style={`--n:${n}`}>
  <figcaption class="flex flex-wrap items-baseline justify-between gap-2">
    <span class="font-serif text-xl font-semibold text-verdigris">{title}</span>
    <span class="flex flex-wrap items-center gap-2 text-xs text-ink-soft">
      <span class="label-mono rounded-[2px] border border-ink-soft px-1.5 py-0.5">
        {kind === 'conceptual' ? 'Conceptual diagram' : 'Documented process'}
      </span>
      Source: {source}
    </span>
  </figcaption>
  <ol class="flow-steps mt-5 grid gap-3">
    {steps.map((s, i) => (
      <li class="flex min-w-0">
        <div
          class="flow-step relative min-w-0 flex-1 rounded-card border-2 border-blue-200 bg-white p-4 break-words"
          style={`--i:${i}`}
        >
          <span class="flow-num inline-flex h-7 w-7 items-center justify-center rounded-full bg-blue text-sm font-bold text-white">
            {i + 1}
          </span>
          <p class="mt-2 font-semibold text-blue">{s.label}</p>
          {s.detail && <p class="mt-1 text-sm text-ink">{s.detail}</p>}
          {s.fan && (
            <span class="mt-3 flex flex-wrap gap-1.5" aria-hidden="true">
              {Array.from({ length: s.fan }, (_, k) => (
                <span class="flow-fan h-3 w-3 rounded-full bg-blue" style={`--k:${k}`} />
              ))}
            </span>
          )}
        </div>
      </li>
    ))}
  </ol>
</figure>

<style>
  /* As many steps per row as fit at a readable width (never squeezed); order is shown by the numbers
     and the walking highlight. */
  .flow-steps {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
  }
  .flow-step {
    animation: flow-walk calc(var(--n) * 1.6s) var(--ease-out, ease-out) infinite;
    animation-delay: calc(var(--i) * 1.6s);
  }
  @keyframes flow-walk {
    0% {
      border-color: #b65d42;
      box-shadow: 0 0 0 4px #f3ddc4;
      transform: translateY(-2px);
    }
    18% {
      border-color: #b65d42;
      box-shadow: 0 0 0 4px #f3ddc4;
      transform: translateY(-2px);
    }
    30%,
    100% {
      border-color: #c9b186;
      box-shadow: 0 0 0 0 transparent;
      transform: none;
    }
  }
  .flow-fan {
    animation: flow-fan 1.2s ease-in-out infinite alternate;
    animation-delay: calc(var(--k) * 140ms);
  }
  @keyframes flow-fan {
    from {
      transform: scale(0.7);
      opacity: 0.5;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }
  .flow:hover *,
  .flow:focus-within * {
    animation-play-state: paused;
  }
  @media (prefers-reduced-motion: reduce) {
    .flow-step,
    .flow-fan {
      animation: none;
    }
  }
</style>
