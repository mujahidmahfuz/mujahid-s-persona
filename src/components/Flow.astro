---
/**
 * Process flow as a scroll story, used in MDX: <Flow title="…" source="…" steps={[{ label, detail, fan? }]} />.
 * Every step must come from the cited source (README, paper, code). Purpose: explanation.
 *
 * ≥1024 px: the steps run down the right column while a sticky panel on the left shows the step
 * being read (large number, label, detail) and a progress meter — native scrolling, never hijacked.
 * Narrower screens: the steps wrap in a grid, and the step crossing the middle of the screen lights up.
 * Without JS: a plain numbered list. Steps with `fan` show n parallel workers.
 */
interface Step {
  label: string;
  detail?: string;
  fan?: number;
}
interface Props {
  title: string;
  steps: Step[];
  source: string;
  /** documented = taken from the project's own docs/code; conceptual = an outline of an idea or plan */
  kind?: 'documented' | 'conceptual';
}
const { title, steps, source, kind = 'documented' } = Astro.props;
const n = steps.length;
const pad = (i: number) => String(i + 1).padStart(2, '0');
---

<figure
  class="flow my-12 rounded-card border border-rule bg-paper-light p-5 md:p-7"
  data-flow
  data-scrollstory
  data-pause-offscreen
>
  <figcaption class="flex flex-wrap items-baseline justify-between gap-2">
    <span class="font-serif text-2xl font-semibold text-verdigris">{title}</span>
    <span class="flex flex-wrap items-center gap-2 text-xs text-ink-soft">
      <span class="label-mono rounded-[2px] border border-ink-soft px-1.5 py-0.5">
        {kind === 'conceptual' ? 'Conceptual diagram' : 'Documented process'}
      </span>
      Source: {source}
    </span>
  </figcaption>

  <div class="mt-6 lg:grid lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)] lg:gap-10">
    <!-- Sticky panel (lg + JS): the step being read. Decorative duplicate of the list → aria-hidden. -->
    <div class="js-only hidden lg:block" aria-hidden="true">
      <div class="sticky top-36 overflow-hidden rounded-card bg-petrol p-7 text-ivory" data-surface="dark" data-spotlight>
        <div class="flex items-start gap-5">
          <div class="relative mt-1 h-40 w-1 shrink-0 rounded-full bg-ivory/15">
            <span
              class="absolute inset-0 rounded-full bg-saffron-light"
              data-story-meter
              style={`transform:scaleY(${1 / n})`}
            ></span>
          </div>
          <div class="relative min-h-[15rem] flex-1">
            {steps.map((s, i) => (
              <div class:list={['story-panel absolute inset-0', i === 0 && 'is-active']} data-story-panel>
                <p class="label-mono text-saffron-light">
                  Step {i + 1} of {n}
                </p>
                <p class="stat-value mt-2 text-[5.5rem] text-ivory/90">{pad(i)}</p>
                <p class="mt-2 font-serif text-[1.7rem] leading-tight font-semibold text-ivory">{s.label}</p>
                {s.detail && <p class="mt-2 text-[0.98rem] text-ivory/85">{s.detail}</p>}
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>

    <ol class="flow-steps grid gap-3 lg:grid-cols-1 lg:gap-4">
      {steps.map((s, i) => (
        <li class="flex min-w-0">
          <div
            class="story-step relative min-w-0 flex-1 rounded-card border-2 border-rule bg-ivory p-5 break-words lg:flex lg:min-h-[10rem] lg:items-start lg:gap-5"
            data-story-step
            data-spotlight
          >
            <span class="flow-num label-mono inline-flex h-8 min-w-8 shrink-0 items-center justify-center rounded-full bg-verdigris px-2 text-sm font-bold text-ivory">
              {pad(i)}
            </span>
            <div class="min-w-0">
              <p class="mt-2 text-[1.05rem] font-semibold text-verdigris lg:mt-1">{s.label}</p>
              {s.detail && <p class="mt-1 text-sm text-ink">{s.detail}</p>}
              {s.fan && (
                <span class="mt-3 flex flex-wrap gap-1.5" aria-hidden="true">
                  {Array.from({ length: s.fan }, (_, k) => (
                    <span class="flow-fan h-3 w-3 rounded-full bg-verdigris" style={`--k:${k}`} />
                  ))}
                </span>
              )}
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</figure>

<style>
  /* Narrow screens: as many steps per row as fit at a readable width (never squeezed). */
  .flow-steps {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 14rem), 1fr));
  }
  @media (min-width: 1024px) {
    .flow-steps {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  :global(.story-step.is-active) .flow-num {
    background: var(--color-terracotta-ink);
  }
  .flow-fan {
    animation: flow-fan 1.2s ease-in-out infinite alternate;
    animation-delay: calc(var(--k) * 140ms);
  }
  @keyframes flow-fan {
    from {
      transform: scale(0.7);
      opacity: 0.5;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .flow-fan {
      animation: none;
    }
  }
</style>
