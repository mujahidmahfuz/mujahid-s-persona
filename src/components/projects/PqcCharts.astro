---
/**
 * Post-quantum cryptography on an Arduino UNO — charts of measured results only.
 * Sources (Muja's Portable_PQC_Container folder): problem_faced.txt, llm-wiki2.txt and
 * new-work(8-29-2026 onward)/ROADMAP.md. Static SVG; each chart carries a screen-reader table.
 */
interface Props {
  chart: 'time' | 'ram';
}
const { chart } = Astro.props;

// Wall-clock time on the UNO (16 MHz AVR), seconds.
const TIME = [
  { op: 'ML-KEM-512 decapsulate', s: 0.133, kind: 'kem' },
  { op: 'ML-KEM-512 encapsulate', s: 0.934, kind: 'kem' },
  { op: 'ML-KEM-768 encapsulate', s: 1.8, kind: 'kem', approx: true },
  { op: 'ML-KEM-1024 encapsulate', s: 3.0, kind: 'kem' },
  { op: 'ML-KEM-1024 decapsulate', s: 3.8, kind: 'kem' },
  { op: 'SLH-DSA-128s verify', s: 25.5, kind: 'sig' },
  { op: 'SLH-DSA-128f sign', s: 38 * 60, kind: 'sig' },
  { op: 'SLH-DSA-128s sign', s: 13 * 3600, kind: 'sig', approx: true },
];
const SRC_TIME = 'ROADMAP.md (Phase 1, Method 5; Phase 2); problem_faced.txt Phase2-I, -J, -K';

// RAM in use (bytes) against the UNO's 2,048 B.
const RAM = [
  { what: 'Reference Kyber-512, ported directly', b: 4000, note: 'does not compile — 195% of RAM' },
  { what: 'Streaming ML-KEM-1024 (enc + dec)', b: 1886, note: '162 B free' },
  { what: 'SLH-DSA-128s verify', b: 2048 - 142, note: '142 B free' },
];
const SRC_RAM = 'problem_faced.txt Problem 1 and Phase2-I; llm-wiki2.txt (ML-KEM-1024 build)';

const fmt = (s: number) =>
  s < 1 ? `${Math.round(s * 1000)} ms` : s < 60 ? `${s} s` : s < 3600 ? `${Math.round(s / 60)} min` : `${Math.round(s / 3600)} h`;
const X0 = 250;
const X1 = 700;
const lx = (s: number) => X0 + ((Math.log10(s) + 1) / 6) * (X1 - X0); // 0.1 s … 100 000 s
const TICKS = [
  { s: 0.1, t: '0.1 s' },
  { s: 1, t: '1 s' },
  { s: 10, t: '10 s' },
  { s: 60, t: '1 min' },
  { s: 3600, t: '1 h' },
  { s: 86400, t: '1 day' },
];
---

{chart === 'time' && (
  <figure class="my-8">
    <figcaption class="text-sm font-semibold text-blue">How long each operation takes on the UNO</figcaption>
    <svg viewBox="0 0 760 360" class="mt-3 h-auto w-full" aria-hidden="true">
      {TICKS.map((k) => (
        <g>
          <line x1={lx(k.s)} x2={lx(k.s)} y1={10} y2={322} stroke="#c9b186" stroke-width={1} />
          <text x={lx(k.s)} y={344} text-anchor="middle" font-size="13" fill="#4c574d">
            {k.t}
          </text>
        </g>
      ))}
      {TIME.map((r, i) => {
        const y = 28 + i * 38;
        return (
          <g>
            <text x={X0 - 12} y={y + 5} text-anchor="end" font-size="14" fill="#26332e">
              {r.op}
            </text>
            <rect
              x={X0}
              y={y - 10}
              width={Math.max(lx(r.s) - X0, 3)}
              height={20}
              rx={4}
              fill={r.kind === 'kem' ? '#354a87' : '#b65d42'}
            />
            <text x={lx(r.s) + 8} y={y + 5} font-size="13" font-weight="600" fill="#26332e">
              {r.approx ? '≈ ' : ''}
              {fmt(r.s)}
            </text>
          </g>
        );
      })}
    </svg>
    <ul class="mt-1 flex flex-wrap gap-x-5 gap-y-1 text-sm text-ink" aria-label="Legend">
      <li class="flex items-center gap-2">
        <svg width="14" height="14" aria-hidden="true">
          <rect x="1" y="1" width="12" height="12" rx="2" fill="#354a87" />
        </svg>
        Key exchange (ML-KEM)
      </li>
      <li class="flex items-center gap-2">
        <svg width="14" height="14" aria-hidden="true">
          <rect x="1" y="1" width="12" height="12" rx="2" fill="#b65d42" />
        </svg>
        Signatures (SLH-DSA)
      </li>
    </ul>
    <div class="sr-only">
      <table>
        <caption>Time per operation on an Arduino UNO</caption>
        <thead>
          <tr>
            <th scope="col">Operation</th>
            <th scope="col">Time</th>
          </tr>
        </thead>
        <tbody>
          {TIME.map((r) => (
            <tr>
              <td>{r.op}</td>
              <td>
                {r.approx ? 'about ' : ''}
                {fmt(r.s)}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-2 text-xs text-ink-soft">
      Log scale — the bars span from a tenth of a second to half a day. ML-KEM-768 is about 1.8 s each way. Source: {SRC_TIME}.
    </p>
  </figure>
)}

{chart === 'ram' && (
  <figure class="my-8">
    <figcaption class="text-sm font-semibold text-blue">RAM in use, against the UNO’s 2,048 bytes</figcaption>
    <ul class="mt-3 list-none space-y-3 pl-0">
      {RAM.map((r) => (
        <li>
          <div class="flex flex-wrap items-baseline justify-between gap-x-3 text-sm">
            <span class="text-ink">{r.what}</span>
            <span class="font-mono tabular-nums">
              {r.b.toLocaleString('en-US')} B · <span class="text-ink-soft">{r.note}</span>
            </span>
          </div>
          <span class="relative mt-1 block h-5 rounded-[4px] bg-paper-light" aria-hidden="true">
            <span
              class="absolute inset-y-0 left-0 rounded-[4px]"
              style={`width:${Math.min(r.b / 4000, 1) * 100}%;background:${r.b > 2048 ? '#b65d42' : '#354a87'}`}
            />
            <span class="absolute inset-y-[-4px] border-l-2 border-dashed border-ink" style={`left:${(2048 / 4000) * 100}%`} />
          </span>
        </li>
      ))}
    </ul>
    <p class="mt-2 text-xs text-ink-soft">
      Dashed line: the UNO’s 2,048 B of RAM. Figures are the compiler’s static-RAM report (direct port, ML-KEM-1024) and the free
      RAM measured at verify time (SLH-DSA). The direct port needs almost twice that before it runs a single line; the streaming
      versions fit with a few hundred bytes — or less — to spare. Source: {SRC_RAM}.
    </p>
  </figure>
)}
