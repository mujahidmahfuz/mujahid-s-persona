---
/** A row of labelled links (Paper · PDF · Code …). Placeholder or empty URLs are skipped. */
import { show } from '~/lib/todo';

interface Props {
  links: { label: string; href?: string | undefined }[];
  label?: string;
}
const { links, label = 'Links' } = Astro.props;
const items = links.filter((l): l is { label: string; href: string } => typeof l.href === 'string' && show(l.href));
---

{items.length > 0 && (
  <ul class="flex flex-wrap items-center gap-x-1 gap-y-2 text-sm" aria-label={label}>
    {items.map((l, i) => (
      <li class="flex items-center gap-1">
        {i > 0 && (
          <span aria-hidden="true" class="text-blue-200">
            ·
          </span>
        )}
        <a href={l.href} class="font-semibold">
          {l.label}
        </a>
      </li>
    ))}
  </ul>
)}
