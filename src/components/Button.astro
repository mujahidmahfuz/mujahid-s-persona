---
import type { HTMLAttributes } from 'astro/types';

type Variant = 'primary' | 'secondary' | 'on-blue';
interface Props extends HTMLAttributes<'a'> {
  href: string;
  variant?: Variant;
}
const { href, variant = 'primary', class: className, ...rest } = Astro.props;
const styles: Record<Variant, string> = {
  primary: 'bg-blue text-white hover:bg-blue-900',
  secondary: 'border-2 border-blue bg-white text-blue hover:bg-blue-050',
  'on-blue': 'bg-white text-blue hover:bg-pink-100',
};
---

<a
  href={href}
  class:list={[
    'inline-flex items-center gap-2 rounded-chip px-5 py-2.5 font-semibold no-underline transition-colors duration-200 ease-out',
    styles[variant],
    className,
  ]}
  {...rest}
>
  <slot />
</a>
