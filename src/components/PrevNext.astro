---
interface Item {
  href: string;
  title: string;
}
interface Props {
  prev?: Item | undefined;
  next?: Item | undefined;
  label?: string;
}
const { prev, next, label = 'More in this section' } = Astro.props;
---

{(prev || next) && (
  <nav aria-label={label} class="mt-16 grid gap-4 border-t border-blue-200 pt-8 sm:grid-cols-2" data-pagefind-ignore="all">
    {prev ? (
      <a href={prev.href} rel="prev" class="rounded-card border border-blue-200 p-4 no-underline hover:border-blue">
        <span class="block text-sm text-muted">← Previous</span>
        <span class="font-semibold text-blue">{prev.title}</span>
      </a>
    ) : (
      <span />
    )}
    {next && (
      <a href={next.href} rel="next" class="rounded-card border border-blue-200 p-4 text-right no-underline hover:border-blue">
        <span class="block text-sm text-muted">Next →</span>
        <span class="font-semibold text-blue">{next.title}</span>
      </a>
    )}
  </nav>
)}
