---
/**
 * Card with a flip side. Tap / click / Enter on a card turns it over (3D rotateY, strong ease-in-out)
 * to show a short summary and "Read more →". The title stays a normal link to the page.
 * Progressive enhancement: without JS the card is a plain card with its summary on the front.
 * Reduced motion: the faces cross-fade instead of rotating.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import StatusBadge, { type Status } from './StatusBadge.astro';
import Chip from './Chip.astro';
import CoverPattern from './CoverPattern.astro';
import Todo from './Todo.astro';
import { isTodo, show } from '~/lib/todo';

interface Props {
  href: string;
  title: string;
  summary?: string | undefined;
  status?: Status | undefined;
  tags?: string[] | undefined;
  meta?: string | undefined;
  cover?: ImageMetadata | undefined;
  coverAlt?: string | undefined;
  variant?: 'research' | 'project' | 'video' | 'award' | 'default';
  /** data-* attributes used by FilterBar (e.g. { area: 'xai ml', status: 'published' }). */
  filters?: Record<string, string> | undefined;
  /** data-s-* sort keys (e.g. { date: '2026-04', featured: '1' }). */
  sorts?: Record<string, string> | undefined;
  external?: boolean;
  headingLevel?: 2 | 3;
}
const {
  href,
  title,
  summary,
  status,
  tags = [],
  meta,
  cover,
  coverAlt = '',
  variant = 'default',
  filters = {},
  sorts = {},
  external = false,
  headingLevel = 3,
} = Astro.props;
const dataAttrs = {
  ...Object.fromEntries(Object.entries(filters).map(([k, v]) => [`data-f-${k}`, v])),
  ...Object.fromEntries(Object.entries(sorts).map(([k, v]) => [`data-s-${k}`, v])),
};
const showCover = variant === 'research' || variant === 'project' || variant === 'video' || cover;
const H = headingLevel === 2 ? 'h2' : 'h3';
const hasSummary = !!summary && show(summary) && !isTodo(summary);
const flippable = hasSummary;
const uid = `card-${Math.random().toString(36).slice(2, 9)}`;
---

<article class="flip-card group relative h-full" data-card data-flippable={flippable ? '' : undefined} {...dataAttrs}>
  <div class="flip-inner relative h-full">
    <!-- FRONT -->
    <div
      class="flip-face flip-front relative flex h-full flex-col overflow-hidden rounded-card border border-rule bg-ivory shadow-[0_14px_28px_-24px_rgba(40,52,47,0.55)] group-hover:shadow-[0_22px_36px_-24px_rgba(40,52,47,0.65)]"
      data-flip-front
    >
      {showCover && (
        <div class="card-cover relative aspect-[8/3] overflow-hidden border-b border-rule" style="background:var(--accent-soft)">
          {cover ? (
            <Image
              src={cover}
              alt={coverAlt}
              widths={[400, 800]}
              sizes="(min-width: 1024px) 380px, 100vw"
              class="h-full w-full object-cover"
            />
          ) : (
            <CoverPattern seed={title} />
          )}
          <div class="absolute top-2 right-2">
            <slot name="badge" />
          </div>
        </div>
      )}
      <div class="flex flex-1 flex-col gap-3 p-5">
        <div class="flex flex-wrap items-center gap-2">
          {status && <StatusBadge status={status} />}
          {meta && <span class="text-sm text-muted">{meta}</span>}
        </div>
        <H class="text-[1.45rem] leading-[1.15]">
          <a
            href={href}
            class:list={['hover:underline', flippable ? 'no-underline' : 'no-underline after:absolute after:inset-0']}
            rel={external ? 'noopener' : undefined}
          >
            {title}
            {external && <span class="sr-only"> (external site)</span>}
          </a>
        </H>
        {/* Summary on the front only without JS (with JS it lives on the back). */}
        {hasSummary && <p class:list={['text-[0.95rem] text-muted', flippable ? 'line-clamp-2' : 'line-clamp-3']}>{summary}</p>}
        {summary && isTodo(summary) && show(summary) && <Todo text={summary} />}
        <slot />
        {tags.length > 0 && (
          <ul class="mt-auto flex flex-wrap gap-1.5 pt-2" aria-label="Tags">
            {tags.slice(0, 3).map((t) => (
              <li>
                <Chip>{t}</Chip>
              </li>
            ))}
          </ul>
        )}
        {flippable && (
          <p class="js-only flex items-center gap-1.5 text-xs font-semibold text-blue" aria-hidden="true">
            <svg
              width="14"
              height="14"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2.2"
              class="flip-hint-icon"
            >
              <path d="M3 12a9 9 0 0 1 15.5-6.2L21 8M21 3v5h-5M21 12a9 9 0 0 1-15.5 6.2L3 16m0 5v-5h5" />
            </svg>
            Turn over for the full summary
          </p>
        )}
      </div>
      {flippable && (
        <button
          type="button"
          class="js-only absolute inset-0 z-10 cursor-pointer rounded-card"
          data-flip-toggle
          aria-expanded="false"
          aria-controls={uid}
          aria-label={`Show summary: ${title}`}
        />
      )}
    </div>

    <!-- BACK -->
    {flippable && (
      <div
        id={uid}
        class="flip-face flip-back js-only absolute inset-0 flex flex-col overflow-hidden rounded-card bg-verdigris p-6 text-ivory shadow-md"
        data-surface="dark"
        data-flip-back
        tabindex="-1"
        aria-label={`Summary: ${title}`}
        inert
      >
        <p class="label-mono text-saffron-light">In short</p>
        <p class="mt-2 font-serif text-xl leading-snug font-semibold">{title}</p>
        <p class="mt-3 flex-1 overflow-auto text-[0.95rem] leading-relaxed text-white/90">{summary}</p>
        <div class="mt-4 flex items-center justify-between gap-3">
          <a href={href} class="read-more inline-flex items-center gap-2 font-semibold" rel={external ? 'noopener' : undefined}>
            Read more
            <span aria-hidden="true" class="read-more-arrow">
              →
            </span>
            <span class="sr-only">: {title}</span>
          </a>
          <button type="button" class="rounded-chip border border-white/50 px-3 py-1 text-sm hover:border-pink" data-flip-close>
            <span aria-hidden="true">↺ </span>Flip back
          </button>
        </div>
      </div>
    )}
  </div>
</article>

<script>
  function setFlipped(card: HTMLElement, on: boolean, focus = true) {
    const front = card.querySelector<HTMLElement>('[data-flip-front]');
    const back = card.querySelector<HTMLElement>('[data-flip-back]');
    const toggle = card.querySelector<HTMLButtonElement>('[data-flip-toggle]');
    if (!front || !back || !toggle) return;
    card.classList.toggle('is-flipped', on);
    toggle.setAttribute('aria-expanded', String(on));
    front.inert = on;
    back.inert = !on;
    if (focus) (on ? back : toggle).focus({ preventScroll: true });
  }
  document.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    const toggle = t.closest<HTMLElement>('[data-flip-toggle]');
    const close = t.closest<HTMLElement>('[data-flip-close]');
    if (toggle) {
      const card = toggle.closest<HTMLElement>('[data-card]')!;
      // one card open at a time
      document.querySelectorAll<HTMLElement>('[data-card].is-flipped').forEach((c) => c !== card && setFlipped(c, false, false));
      setFlipped(card, true);
    } else if (close) {
      setFlipped(close.closest<HTMLElement>('[data-card]')!, false);
    }
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    const card = (document.activeElement as HTMLElement | null)?.closest<HTMLElement>('[data-card].is-flipped');
    if (card) setFlipped(card, false);
  });
</script>
