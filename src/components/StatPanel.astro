---
/**
 * "By the numbers" — up to four sourced headline figures, shown large. Each value is rendered in
 * full on the server; with JS and motion allowed it counts up once when it scrolls into view.
 * Sources are listed underneath so every figure can be traced (CLAUDE.md rule 1).
 */
interface Stat {
  value: string;
  label: string;
  source: string;
}
interface Props {
  stats: Stat[];
  title?: string;
  layout?: 'panel' | 'row';
}
const { stats, title = 'By the numbers', layout = 'panel' } = Astro.props;
const sources = [...new Set(stats.map((s) => s.source))];
---

{stats.length > 0 && (
  <section
    aria-label={title}
    data-surface="dark"
    class:list={[
      'rounded-card border border-ivory/20 bg-ivory/[0.06] backdrop-blur-[2px]',
      layout === 'panel' ? 'p-6 md:p-7' : 'p-5 md:p-6',
    ]}
    data-spotlight
  >
    <p class="label-mono text-saffron-light">{title}</p>
    <dl
      class:list={['mt-5 grid gap-x-8 gap-y-6', layout === 'panel' ? 'grid-cols-1 sm:grid-cols-2' : 'grid-cols-2 lg:grid-cols-4']}
    >
      {stats.map((s) => (
        <div class="flex flex-col-reverse gap-2 border-t border-ivory/20 pt-4">
          <dt class="text-sm leading-snug text-ivory/80">{s.label}</dt>
          <dd class="stat-value text-[clamp(2.2rem,1.8rem+1.6vw,3.25rem)] text-ivory" data-countup>
            {s.value}
          </dd>
        </div>
      ))}
    </dl>
    <p class="mt-5 text-xs text-ivory/70">Source: {sources.join('; ')}.</p>
  </section>
)}
