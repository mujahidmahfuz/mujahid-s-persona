---
/**
 * Client-side filters that sync to the URL query (?area=xai&status=published).
 * Cards inside [data-filter-scope] carry data-f-<key>="token token" attributes.
 * Without JS the form still renders, every card stays visible ("show all").
 */
interface Option {
  value: string;
  label: string;
}
interface Field {
  key: string;
  label: string;
  options: Option[];
}
interface Props {
  fields: Field[];
  sort?: Option[];
  scope: string;
}
const { fields, sort = [], scope } = Astro.props;
---

<form
  class="mb-8 grid grid-cols-2 items-end gap-3 rounded-card bg-blue-050 p-4 sm:flex sm:flex-wrap sm:gap-4"
  data-filter-bar={scope}
  role="search"
  aria-label="Filter"
>
  {fields.map((f) => (
    <label class="flex flex-col gap-1 text-sm font-semibold text-blue">
      {f.label}
      <select
        name={f.key}
        class="w-full min-w-0 rounded-lg sm:w-auto sm:min-w-36 border border-blue-200 bg-white px-3 py-2 font-normal text-ink"
      >
        <option value="">All</option>
        {f.options.map((o) => (
          <option value={o.value}>{o.label}</option>
        ))}
      </select>
    </label>
  ))}
  {sort.length > 0 && (
    <label class="flex flex-col gap-1 text-sm font-semibold text-blue">
      Sort
      <select
        name="sort"
        class="w-full min-w-0 rounded-lg sm:w-auto sm:min-w-36 border border-blue-200 bg-white px-3 py-2 font-normal text-ink"
      >
        {sort.map((o) => (
          <option value={o.value}>{o.label}</option>
        ))}
      </select>
    </label>
  )}
  <button
    type="reset"
    class="rounded-chip border-2 border-blue bg-white px-4 py-2 text-sm font-semibold text-blue hover:bg-white/60"
  >
    Clear
  </button>
  <p class="col-span-2 self-center text-sm text-muted sm:ml-auto" aria-live="polite" data-filter-count></p>
</form>

<script>
  function initFilterBar(form: HTMLFormElement) {
    const scope = document.querySelector<HTMLElement>(`[data-filter-scope="${form.dataset.filterBar}"]`);
    if (!scope) return;
    const cards = Array.from(scope.querySelectorAll<HTMLElement>('[data-card]'));
    const items = cards.map((c) => c.closest<HTMLElement>('[data-filter-item]') ?? c);
    const original = items.slice();
    const count = form.querySelector<HTMLElement>('[data-filter-count]');
    const selects = Array.from(form.querySelectorAll<HTMLSelectElement>('select'));

    const params = new URLSearchParams(location.search);
    for (const s of selects) {
      const v = params.get(s.name);
      if (v && Array.from(s.options).some((o) => o.value === v)) s.value = v;
    }

    function apply() {
      const active = selects.filter((s) => s.name !== 'sort' && s.value);
      let shown = 0;
      cards.forEach((card, i) => {
        const ok = active.every((s) =>
          (card.dataset[`f${s.name[0]!.toUpperCase()}${s.name.slice(1)}`] ?? '').split(' ').includes(s.value),
        );
        items[i]!.hidden = !ok;
        if (ok) shown++;
      });
      const sortSel = selects.find((s) => s.name === 'sort');
      if (sortSel) {
        const key = sortSel.value;
        const sorted = original.slice().sort((a, b) => {
          const ca = a.matches('[data-card]') ? a : a.querySelector<HTMLElement>('[data-card]')!;
          const cb = b.matches('[data-card]') ? b : b.querySelector<HTMLElement>('[data-card]')!;
          return (cb.dataset[`s${key[0]!.toUpperCase()}${key.slice(1)}`] ?? '').localeCompare(
            ca.dataset[`s${key[0]!.toUpperCase()}${key.slice(1)}`] ?? '',
          );
        });
        const parent = original[0]?.parentElement;
        if (parent) sorted.forEach((el) => parent.appendChild(el));
      }
      if (count) count.textContent = `Showing ${shown} of ${cards.length}`;
      const q = new URLSearchParams();
      for (const s of selects) if (s.value && !(s.name === 'sort' && s.selectedIndex === 0)) q.set(s.name, s.value);
      const qs = q.toString();
      history.replaceState(null, '', qs ? `?${qs}` : location.pathname);
    }

    form.addEventListener('change', apply);
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      apply();
    });
    form.addEventListener('reset', () => setTimeout(apply, 0));
    apply();
  }
  document.querySelectorAll<HTMLFormElement>('[data-filter-bar]').forEach(initFilterBar);
</script>
