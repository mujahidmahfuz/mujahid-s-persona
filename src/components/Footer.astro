---
import { PROFILES, SITE } from '~/lib/site';
import { withBase } from '~/lib/paths';

const built = new Date().toISOString().slice(0, 10);
---

<footer class="surface-dark mt-28 print:hidden" data-surface="dark" data-pagefind-ignore="all">
  <div class="container-site grid gap-10 py-14 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <p class="font-serif text-2xl font-semibold">{SITE.name}</p>
      <p class="mt-2 max-w-sm text-sm text-ivory/85">{SITE.affiliation}</p>
      <p class="label-mono mt-6 text-saffron-light">An unfinished atlas · kept since 2023</p>
    </div>
    <nav aria-label="Profiles">
      <p class="label-mono text-saffron-light">Elsewhere</p>
      <ul class="mt-3 space-y-1.5 text-sm">
        {
          PROFILES.map((p) => (
            <li>
              <a href={p.href} rel="me noopener">
                {p.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="text-sm">
      <p class="label-mono text-saffron-light">This atlas</p>
      <ul class="mt-3 space-y-1.5">
        <li><a href={withBase('/contact/')}>Write to me</a></li>
        <li><a href={withBase('/rss.xml')}>RSS (notes)</a></li>
        <li><a href={SITE.sourceRepo} rel="noopener">Source code</a></li>
      </ul>
      <p class="label-mono mt-6 text-ivory/80">
        Last revised <time datetime={built}>{built}</time>
      </p>
    </div>
  </div>
</footer>
