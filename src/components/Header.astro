---
import { NAV } from '~/lib/site';
import { withBase, stripBase } from '~/lib/paths';

const current = stripBase(Astro.url.pathname);
const isActive = (href: string) => current === href || current.startsWith(href);
---

<header
  data-site-header
  class="sticky top-0 z-40 border-b border-rule bg-parchment/92 backdrop-blur-[6px] print:hidden"
  data-pagefind-ignore="all"
>
  <div class="container-site flex h-16 items-center justify-between gap-4">
    <a
      href={withBase('/')}
      class="nav-link relative font-serif text-[1.35rem] leading-none font-semibold text-verdigris no-underline"
      aria-current={current === '/' ? 'page' : undefined}
    >
      Home
    </a>

    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-0.5">
        {NAV.map((item) => (
          <li>
            <a
              href={withBase(item.href)}
              class:list={[
                'nav-link relative rounded-sm px-3 py-2 text-[0.92rem] text-ink no-underline transition-colors duration-150 hover:text-verdigris',
                isActive(item.href) && 'is-active font-semibold text-verdigris',
              ]}
              aria-current={isActive(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={withBase('/search/')}
        data-search-open
        aria-keyshortcuts="Control+K Meta+K"
        class="inline-flex items-center gap-2 rounded-chip border border-ink-soft px-3 py-1.5 text-sm text-ink no-underline hover:border-verdigris"
      >
        <svg aria-hidden="true" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="m20 20-3.5-3.5"></path>
        </svg>
        <span class="sr-only sm:not-sr-only">Search</span>
        <kbd aria-hidden="true" class="label-mono hidden rounded border border-rule px-1 text-[0.65rem] sm:inline">
          Ctrl K
        </kbd>
      </a>

      <details class="relative lg:hidden" data-mobile-nav>
        <summary class="cursor-pointer list-none rounded-chip border border-ink-soft px-3 py-1.5 text-sm text-ink">Menu</summary>
        <nav aria-label="Main (mobile)" class="paper-card absolute right-0 mt-2 w-60 rounded-card p-2">
          <ul>
            {NAV.map((item) => (
              <li>
                <a
                  href={withBase(item.href)}
                  class:list={[
                    'block rounded-sm px-3 py-2 text-ink no-underline hover:bg-paper-light',
                    isActive(item.href) && 'font-semibold text-verdigris',
                  ]}
                  aria-current={isActive(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>

<style>
  .nav-link::after {
    content: '';
    position: absolute;
    left: 0.75rem;
    right: 0.75rem;
    bottom: 0.25rem;
    height: 1.5px;
    background: var(--color-terracotta);
    transform: scaleX(0);
    transform-origin: 0 50%;
    transition: transform 220ms var(--ease-out);
  }
  .nav-link.is-active::after {
    transform: scaleX(1);
  }
  @media (hover: hover) and (pointer: fine) {
    .nav-link:hover::after {
      transform: scaleX(1);
    }
  }
</style>
