---
/**
 * Private workspace — password-locked. Content is AES-256-GCM ciphertext (scripts/vault.ts),
 * decrypted only in the browser after the password is entered. Not in nav, sitemap, search
 * index or robots; noindex. The source files live in private/ (git-ignored).
 */
import BaseLayout from '~/layouts/BaseLayout.astro';

const files = import.meta.glob<{ default: Record<string, unknown> }>('/src/data/vault.enc.json', { eager: true });
const vault = files['/src/data/vault.enc.json']?.default;
---

<BaseLayout title="Private workspace" description="Private workspace." noindex searchable={false}>
  <div class="container-site py-12 md:py-16" data-vault-root>
    <h1>Private workspace</h1>

    {vault ? (
      <>
        <form class="mt-8 max-w-md rounded-card bg-blue p-6 text-white" data-surface="blue" data-vault-form>
          <label for="vault-password" class="block font-semibold">
            Password
          </label>
          <input
            id="vault-password"
            type="password"
            autocomplete="current-password"
            required
            class="mt-2 w-full rounded-lg border-2 border-white/60 bg-white px-3 py-2 text-ink"
          />
          <label class="mt-3 flex items-center gap-2 text-sm">
            <input type="checkbox" data-vault-remember /> Stay unlocked in this tab
          </label>
          <button type="submit" class="mt-4 rounded-chip bg-white px-5 py-2 font-semibold text-blue hover:bg-pink-100">
            Unlock
          </button>
          <p class="mt-3 min-h-[1.5em] text-sm text-pink" role="alert" aria-live="assertive" data-vault-error />
        </form>
        <noscript>
          <p class="mt-6">This page needs JavaScript to decrypt its contents.</p>
        </noscript>
        <script type="application/json" id="vault-data" set:html={JSON.stringify(vault)} />
      </>
    ) : (
      <p class="mt-6 text-muted">The workspace has not been set up on this build.</p>
    )}

    <div hidden data-vault-app>
      <div class="mt-6 flex flex-wrap items-end gap-3 rounded-card bg-blue-050 p-4">
        <label class="flex flex-col gap-1 text-sm font-semibold text-blue">
          Search
          <input
            type="search"
            class="w-56 rounded-lg border border-blue-200 bg-white px-3 py-2 font-normal text-ink"
            data-vf="q"
          />
        </label>
        <label class="flex flex-col gap-1 text-sm font-semibold text-blue">
          Visibility
          <select class="rounded-lg border border-blue-200 bg-white px-3 py-2 font-normal text-ink" data-vf="visibility">
            <option value="">All</option>
            <option value="private">Unpublished (private)</option>
            <option value="public">Public, in progress</option>
          </select>
        </label>
        <label class="flex flex-col gap-1 text-sm font-semibold text-blue">
          Section
          <select class="rounded-lg border border-blue-200 bg-white px-3 py-2 font-normal text-ink" data-vf="section">
            <option value="">All</option>
          </select>
        </label>
        <label class="flex flex-col gap-1 text-sm font-semibold text-blue">
          Status
          <select class="rounded-lg border border-blue-200 bg-white px-3 py-2 font-normal text-ink" data-vf="status">
            <option value="">All</option>
          </select>
        </label>
        <label class="flex flex-col gap-1 text-sm font-semibold text-blue">
          Group by
          <select class="rounded-lg border border-blue-200 bg-white px-3 py-2 font-normal text-ink" data-vf="group">
            <option value="section">Section</option>
            <option value="status">Status</option>
            <option value="visibility">Visibility</option>
          </select>
        </label>
        <button
          type="button"
          class="ml-auto rounded-chip border-2 border-blue bg-white px-4 py-2 text-sm font-semibold text-blue"
          data-vault-lock
        >
          Lock
        </button>
      </div>
      <p class="mt-3 text-sm text-muted" aria-live="polite" data-vault-count></p>
      <div class="mt-6 space-y-10" data-vault-list></div>
      <section class="mt-16 max-w-prose text-sm text-muted" aria-labelledby="vault-help">
        <h2 id="vault-help" class="text-h3">
          How this works
        </h2>
        <ul class="mt-3 list-disc space-y-1 pl-5">
          <li>
            Unpublished work lives in <code>private/&lt;section&gt;/</code> on your laptop (never pushed). Add a folder to create
            a new section.
          </li>
          <li>
            Run <code>npm run vault</code> (or any build) to re-encrypt, then commit <code>src/data/vault.enc.json</code>.
          </li>
          <li>
            To publish an item: move its file to <code>src/content/research/</code> or <code>src/content/projects/</code> and
            remove <code>private: true</code>.
          </li>
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  type Item = {
    key: string;
    section: string;
    visibility: 'private' | 'public';
    title: string;
    status: string;
    summary: string;
    kind?: string;
    date?: string;
    tags: string[];
    areas: string[];
    todos: string[];
    html: string;
    file: string;
    url?: string;
  };
  type Enc = { iterations: number; salt: string; iv: string; data: string };
  const SESSION_KEY = 'vault-pass';
  const b64 = (s: string) => Uint8Array.from(atob(s), (c) => c.charCodeAt(0));
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);

  async function decrypt(enc: Enc, password: string): Promise<Item[]> {
    const base = await crypto.subtle.importKey('raw', new TextEncoder().encode(password), 'PBKDF2', false, ['deriveKey']);
    const key = await crypto.subtle.deriveKey(
      { name: 'PBKDF2', hash: 'SHA-256', salt: b64(enc.salt), iterations: enc.iterations },
      base,
      { name: 'AES-GCM', length: 256 },
      false,
      ['decrypt'],
    );
    const plain = await crypto.subtle.decrypt({ name: 'AES-GCM', iv: b64(enc.iv) }, key, b64(enc.data));
    return (JSON.parse(new TextDecoder().decode(plain)) as { items: Item[] }).items;
  }

  const STATUS_STYLE: Record<string, string> = {
    published: 'bg-blue text-white border-blue',
    accepted: 'bg-blue text-white border-blue',
    'under-review': 'bg-white text-blue border-blue',
    'in-preparation': 'bg-white text-blue border-blue',
    'in-progress': 'bg-pink-100 text-blue border-pink-100',
    prototype: 'bg-pink-100 text-blue border-pink-100',
    concept: 'bg-white text-blue border-blue border-dashed',
    archived: 'bg-blue-050 text-muted border-blue-200',
  };
  const badge = (s: string) =>
    `<span class="inline-flex rounded-chip border-2 px-2.5 py-0.5 text-xs font-semibold ${STATUS_STYLE[s] ?? 'bg-white text-blue border-blue-200'}">${esc(s || 'no status')}</span>`;

  function card(i: Item): string {
    const vis =
      i.visibility === 'private'
        ? '<span class="rounded-chip bg-blue-900 px-2.5 py-0.5 text-xs font-semibold text-white">Unpublished</span>'
        : `<a class="rounded-chip border border-blue-200 px-2.5 py-0.5 text-xs font-semibold" href="${esc(i.url ?? '#')}">Public page →</a>`;
    const todos = i.todos.length
      ? `<div class="mt-3"><p class="text-sm font-semibold text-blue">Open items (${i.todos.length})</p><ul class="mt-1 list-disc pl-5 text-sm">${i.todos.map((t) => `<li>${esc(t)}</li>`).join('')}</ul></div>`
      : '';
    const tags = i.tags.length ? `<p class="mt-2 text-xs text-muted">${i.tags.map((t) => `#${esc(t)}`).join(' ')}</p>` : '';
    return `<details class="rounded-card border border-blue-200 bg-white p-4 open:shadow-md">
      <summary class="cursor-pointer list-none">
        <div class="flex flex-wrap items-center gap-2">${badge(i.status)}${vis}${i.kind ? `<span class="text-xs text-muted">${esc(i.kind)}</span>` : ''}${i.date && !i.date.includes('TODO(muja)') ? `<span class="text-xs text-muted">${esc(i.date)}</span>` : ''}</div>
        <p class="mt-2 font-display text-lg font-bold text-blue">${esc(i.title)}</p>
        ${i.summary && !i.summary.startsWith('TODO(muja)') ? `<p class="mt-1 text-sm text-muted">${esc(i.summary)}</p>` : ''}
      </summary>
      <div class="vault-body prose-site mt-4 border-t border-blue-200 pt-4">${i.html}</div>
      ${todos}${tags}
      <p class="mt-3 font-mono text-xs text-muted">${esc(i.file)}</p>
    </details>`;
  }

  const root = document.querySelector<HTMLElement>('[data-vault-root]')!;
  const form = root.querySelector<HTMLFormElement>('[data-vault-form]');
  const app = root.querySelector<HTMLElement>('[data-vault-app]')!;
  const list = app.querySelector<HTMLElement>('[data-vault-list]')!;
  const count = app.querySelector<HTMLElement>('[data-vault-count]')!;
  const err = root.querySelector<HTMLElement>('[data-vault-error]');
  const enc = JSON.parse(document.getElementById('vault-data')?.textContent ?? 'null') as Enc | null;
  const f = (name: string) => app.querySelector<HTMLInputElement | HTMLSelectElement>(`[data-vf="${name}"]`)!;
  let items: Item[] = [];

  function fillSelect(name: string, values: string[]) {
    const sel = f(name) as HTMLSelectElement;
    sel.length = 1;
    for (const v of [...new Set(values)].sort()) sel.add(new Option(v, v));
  }

  function draw() {
    const q = f('q').value.trim().toLowerCase();
    const vis = f('visibility').value;
    const sec = f('section').value;
    const st = f('status').value;
    const group = f('group').value as 'section' | 'status' | 'visibility';
    const shown = items.filter(
      (i) =>
        (!vis || i.visibility === vis) &&
        (!sec || i.section === sec) &&
        (!st || i.status === st) &&
        (!q || [i.title, i.summary, i.tags.join(' '), i.html, i.todos.join(' ')].join(' ').toLowerCase().includes(q)),
    );
    const groups = new Map<string, Item[]>();
    for (const i of shown) groups.set(i[group] || '—', [...(groups.get(i[group] || '—') ?? []), i]);
    list.innerHTML = [...groups]
      .sort(([a], [b]) => a.localeCompare(b))
      .map(
        ([g, xs]) =>
          `<section><h2 class="text-h3 capitalize">${esc(g)} <span class="text-base font-normal text-muted">(${xs.length})</span></h2><div class="mt-4 grid gap-4 lg:grid-cols-2">${xs.map(card).join('')}</div></section>`,
      )
      .join('');
    const open = shown.reduce((n, i) => n + i.todos.length, 0);
    count.textContent = `${shown.length} of ${items.length} items · ${open} open items`;
  }

  function show(decrypted: Item[]) {
    items = decrypted;
    fillSelect(
      'section',
      items.map((i) => i.section),
    );
    fillSelect(
      'status',
      items.map((i) => i.status),
    );
    form?.setAttribute('hidden', '');
    app.hidden = false;
    draw();
    app.querySelectorAll('[data-vf]').forEach((el) => el.addEventListener('input', draw));
  }

  async function unlock(password: string, remember: boolean) {
    if (!enc) return;
    try {
      show(await decrypt(enc, password));
      if (remember) sessionStorage.setItem(SESSION_KEY, password);
      if (err) err.textContent = '';
    } catch {
      if (err) err.textContent = 'Wrong password.';
    }
  }

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const pw = form.querySelector<HTMLInputElement>('#vault-password')!;
    const remember = form.querySelector<HTMLInputElement>('[data-vault-remember]')!.checked;
    if (err) err.textContent = 'Unlocking…';
    void unlock(pw.value, remember);
    pw.value = '';
  });
  app.querySelector('[data-vault-lock]')?.addEventListener('click', () => {
    sessionStorage.removeItem(SESSION_KEY);
    items = [];
    list.innerHTML = '';
    app.hidden = true;
    form?.removeAttribute('hidden');
  });
  const saved = sessionStorage.getItem(SESSION_KEY);
  if (saved) void unlock(saved, true);
</script>

<style is:global>
  .vault-todo {
    display: inline-block;
    border: 2px dashed var(--color-pink);
    background: var(--color-pink-100);
    color: var(--color-blue);
    border-radius: 999px;
    padding: 0 0.5rem;
    font-size: 0.8rem;
  }
  .vault-body h3,
  .vault-body h4 {
    font-size: 1.1rem;
  }
</style>
