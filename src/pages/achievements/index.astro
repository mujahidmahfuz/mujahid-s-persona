---
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageIntro from '~/components/PageIntro.astro';
import Card from '~/components/Card.astro';
import { getPublic, formatDate, dateKey } from '~/lib/content';
import { entryPath } from '~/lib/paths';
import { show } from '~/lib/todo';

const all = (await getPublic('awards')).sort(
  (a, b) => dateKey(b.data.date).localeCompare(dateKey(a.data.date)) || a.id.localeCompare(b.id),
);
---

<BaseLayout title="Achievements" description="Competitions, awards and honours of Md Mujahidul Islam.">
  <PageIntro
    eyebrow="Chapter IV · A ledger"
    title="Achievements"
    lede="A few moments that marked the way, each with its context — not a scoreboard."
    epigraph="achievements"
    treatment="verse"
    layout="stacked"
  >
    <p class="mt-5 max-w-3xl text-ink-soft">Competitions, publications and honours.</p>
  </PageIntro>
  <div class="container-site py-12 md:py-14">
    <ul class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4" data-reveal-group>
      {all.map((a) => (
        <li>
          <Card
            variant="award"
            href={entryPath(a)}
            title={a.data.title}
            summary={show(a.data.description) ? a.data.description : undefined}
            meta={[a.data.issuer, formatDate(a.data.date)].filter(Boolean).join(' · ')}
            headingLevel={2}
            tags={[a.data.category]}
          />
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
