---
/** Publications: research entries with a DOI or an accepted/published status (SPEC §2). Metadata from Crossref. */
import BaseLayout from '~/layouts/BaseLayout.astro';
import Citation from '~/components/Citation.astro';
import BibtexButton from '~/components/BibtexButton.astro';
import StatusBadge from '~/components/StatusBadge.astro';
import { getResearch, bibtex } from '~/lib/content';
import { entryPath, withBase } from '~/lib/paths';
import { SITE } from '~/lib/site';

const pubs = (await getResearch())
  .filter((r) => r.data.doi || r.data.status === 'published' || r.data.status === 'accepted')
  .sort((a, b) => (b.cite.year ?? 0) - (a.cite.year ?? 0) || a.cite.title.localeCompare(b.cite.title));
---

<BaseLayout title="Publications" description="Peer-reviewed publications by Md Mujahidul Islam, with citations and BibTeX.">
  <div class="container-site py-12 md:py-16">
    <h1>Publications</h1>
    <p class="mt-4 max-w-prose text-muted">
      Titles, authors and venues are pulled from Crossref by DOI at build time. Work in progress is listed on the{' '}
      <a href={withBase('/research/')}>research page</a>. Full list also on{' '}
      <a href={`https://orcid.org/${SITE.orcidId}`}>ORCID</a>.
    </p>
    <ol class="mt-10 max-w-4xl space-y-10">
      {pubs.map((p) => (
        <li class="border-l-4 border-blue pl-5">
          <div class="mb-2 flex flex-wrap items-center gap-3">
            <StatusBadge status={p.data.status} />
            {p.data.featured && <span class="text-sm font-semibold text-pink-ink">Featured</span>}
          </div>
          <Citation cite={p.cite} />
          <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm font-semibold">
            <a href={entryPath(p)}>
              Plain-language summary<span class="sr-only"> of {p.cite.title}</span>
            </a>
            {p.data.doi && (
              <a href={`https://doi.org/${p.data.doi}`}>
                DOI<span class="sr-only"> for {p.cite.title}</span>
              </a>
            )}
          </p>
          {p.data.doi && bibtex(p.data.doi) && <BibtexButton bibtex={bibtex(p.data.doi)!} id={p.id} />}
        </li>
      ))}
    </ol>
  </div>
</BaseLayout>
