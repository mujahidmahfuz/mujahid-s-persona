---
/** The library: published papers as paper objects (Website_Redesign.md §9–10). Metadata from Crossref. */
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageIntro from '~/components/PageIntro.astro';
import PaperObject from '~/components/PaperObject.astro';
import { getResearch } from '~/lib/content';
import { withBase } from '~/lib/paths';
import { SITE } from '~/lib/site';

const pubs = (await getResearch())
  .filter((r) => r.data.doi || r.data.status === 'published' || r.data.status === 'accepted')
  .sort((a, b) => (b.cite.year ?? 0) - (a.cite.year ?? 0) || a.cite.title.localeCompare(b.cite.title));
---

<BaseLayout title="Publications" description="Peer-reviewed publications by Md Mujahidul Islam, with citations, DOIs and BibTeX.">
  <PageIntro
    eyebrow="Chapter III · The library"
    title="Publications"
    lede="Work that has passed peer review. Each paper keeps its full bibliographic record, a citation you can copy, and a way in."
    epigraph="publications"
    treatment="plate"
    layout="stacked"
  />
  <div class="container-site py-14">
    <div class="space-y-16">
      {pubs.map((p, i) => (
        <PaperObject entry={p} folio={`P-${String(i + 1).padStart(2, '0')}`} />
      ))}
    </div>
    <aside class="mt-16 max-w-5xl border-t border-rule pt-6 text-sm text-ink-soft">
      <p>
        <strong class="text-ink">About the covers.</strong> The images are the journals' own covers (© Elsevier, © Springer
        Nature), shown only to identify each journal. They are representative issues, not necessarily the issue carrying the
        paper. Titles, authors, venues, volumes and years come from Crossref by DOI at build time. The full list is also on{' '}
        <a href={`https://orcid.org/${SITE.orcidId}`}>ORCID</a>; work in progress is under{' '}
        <a href={withBase('/research/')}>Research</a>.
      </p>
    </aside>
  </div>
</BaseLayout>
