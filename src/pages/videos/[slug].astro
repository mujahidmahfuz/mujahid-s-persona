---
import { render, type CollectionEntry } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Epigraph from '~/components/Epigraph.astro';
import VideoFacade from '~/components/VideoFacade.astro';
import Card from '~/components/Card.astro';
import PrevNext from '~/components/PrevNext.astro';
import Todo from '~/components/Todo.astro';
import { getPublic, getResearch, formatDate } from '~/lib/content';
import { entryPath, withBase } from '~/lib/paths';

export async function getStaticPaths() {
  const list = (await getPublic('videos')).sort((a, b) => b.data.date.localeCompare(a.data.date));
  return list.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, prev: list[i - 1], next: list[i + 1] } }));
}
type V = CollectionEntry<'videos'>;
interface Props {
  entry: V;
  prev?: V | undefined;
  next?: V | undefined;
}
const { entry, prev, next } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const pool = [
  ...(await getResearch()),
  ...(await getPublic('projects')),
  ...(await getPublic('sports')),
  ...(await getPublic('awards')),
  ...(await getPublic('notes')),
];
const rel = pool.filter((p) => d.related.some((r) => r.collection === p.collection && r.slug === p.id));
const titleOf = (p: (typeof pool)[number]): string => ('team' in p.data ? p.data.team : p.data.title);
---

<BaseLayout title={d.title} description={d.description}>
  <article class="container-site py-12 md:py-16">
    <p class="text-sm font-semibold text-pink-ink">
      <a href={withBase('/videos/')}>Videos</a> · {d.category}
    </p>
    <h1 class="mt-3">{d.title}</h1>
    <div class="mt-8 mb-2">
      <Epigraph page={`videos/${entry.id}`} treatment="margin" />
    </div>
    <p class="mt-2 text-muted">{formatDate(d.date)}</p>
    <div class="mt-8 max-w-6xl">
      <VideoFacade videoId={d.videoId} title={d.title} start={d.start} />
    </div>
    <div class="prose-site mt-8">
      <p>{d.description}</p>
      <Content components={{ Todo }} />
    </div>
    {rel.length > 0 && (
      <section class="mt-12" aria-labelledby="related">
        <h2 id="related">Related</h2>
        <ul class="mt-6 grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-reveal-group>
          {rel.map((r) => (
            <li>
              <Card href={entryPath(r)} title={titleOf(r)} />
            </li>
          ))}
        </ul>
      </section>
    )}
    <PrevNext
      label="More videos"
      prev={prev && { href: entryPath(prev), title: prev.data.title }}
      next={next && { href: entryPath(next), title: next.data.title }}
    />
  </article>
</BaseLayout>
