---
/** Contact — email assembled client-side (CLAUDE.md rule 7); no plain mailto in the HTML. */
import BaseLayout from '~/layouts/BaseLayout.astro';
import PageIntro from '~/components/PageIntro.astro';
import { EMAIL_PARTS, PROFILES, SITE } from '~/lib/site';

// Reversed parts so the address never appears in order in the source.
const u = [...EMAIL_PARTS.user].reverse().join('');
const d = [...EMAIL_PARTS.domain].reverse().join('');
---

<BaseLayout title="Contact" description="How to contact Md Mujahidul Islam: email, Google Scholar, ORCID, GitHub, LinkedIn.">
  <PageIntro
    eyebrow="Closing · An invitation"
    title="Contact"
    lede="If something here made you curious, I would like to hear about it."
    epigraph="contact"
    treatment="note"
    layout="split"
  >
    <p class="mt-5 max-w-3xl text-ink-soft">
      I am an undergraduate researcher at {SITE.university}. For research questions or collaboration, email is best.
    </p>
  </PageIntro>
  <div class="container-site py-12 md:py-14">
    <section class="mt-10 max-w-3xl rounded-card bg-blue p-6 text-white" data-surface="dark" aria-labelledby="email">
      <h2 id="email" class="text-h3">
        Email
      </h2>
      <p class="mt-3 min-h-[1.6em] text-lg font-semibold" data-email data-u={u} data-d={d}>
        <noscript>Turn on JavaScript to see the address, or reach me on LinkedIn.</noscript>
      </p>
      <button
        type="button"
        class="mt-3 hidden rounded-chip bg-white px-4 py-2 text-sm font-semibold text-blue hover:bg-pink-100"
        data-email-copy
      >
        Copy address
      </button>
      <p class="mt-2 text-sm text-white/85" role="status" aria-live="polite" data-email-status></p>
    </section>

    <section class="mt-10" aria-labelledby="profiles">
      <h2 id="profiles" class="text-h3">
        Profiles
      </h2>
      <ul class="mt-4 grid max-w-3xl gap-3 sm:grid-cols-2" data-reveal-group>
        {PROFILES.map((p) => (
          <li>
            <a
              href={p.href}
              rel="me noopener"
              class="block rounded-card border border-blue-200 p-4 font-semibold no-underline hover:border-blue"
            >
              {p.label}
              <span class="block text-sm font-normal break-all text-muted">{p.href.replace(/^https?:\/\/(www\.)?/, '')}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  </div>
</BaseLayout>

<script>
  const el = document.querySelector<HTMLElement>('[data-email]');
  if (el) {
    const rev = (s: string) => [...s].reverse().join('');
    const addr = `${rev(el.dataset.u ?? '')}@${rev(el.dataset.d ?? '')}`;
    const a = document.createElement('a');
    a.href = `mailto:${addr}`;
    a.textContent = addr;
    el.replaceChildren(a);
    const btn = document.querySelector<HTMLButtonElement>('[data-email-copy]');
    const status = document.querySelector<HTMLElement>('[data-email-status]');
    if (btn && navigator.clipboard) {
      btn.classList.remove('hidden');
      btn.addEventListener('click', async () => {
        await navigator.clipboard.writeText(addr);
        if (status) status.textContent = 'Email address copied';
      });
    }
  }
</script>
