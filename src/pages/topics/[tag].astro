---
/** Everything sharing a tag: research + projects + notes + videos + experience + awards. */
import BaseLayout from '~/layouts/BaseLayout.astro';
import Card from '~/components/Card.astro';
import { allTopicItems as allItems, type TopicItem as Item } from '~/lib/topics';

export async function getStaticPaths() {
  const items = await allItems();
  const tags = [...new Set(items.flatMap((i) => i.tags))].sort();
  return tags.map((tag) => ({ params: { tag }, props: { tag, items: items.filter((i) => i.tags.includes(tag)) } }));
}

interface Props {
  tag: string;
  items: Item[];
}
const { tag, items } = Astro.props;
---

<BaseLayout title={`Topic: ${tag}`} description={`Research, projects and notes tagged “${tag}”.`}>
  <div class="container-site py-12 md:py-16">
    <p class="text-sm font-semibold text-pink-ink">Topic</p>
    <h1 class="mt-2">#{tag}</h1>
    <p class="mt-3 text-muted">
      {items.length} {items.length === 1 ? 'item' : 'items'}
    </p>
    <ul class="mt-8 grid gap-6 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4" data-reveal-group>
      {items.map((i) => (
        <li>
          <Card href={i.href} title={i.title} summary={i.summary} meta={i.kind} headingLevel={2} />
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>
