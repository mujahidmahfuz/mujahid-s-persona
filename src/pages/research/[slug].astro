---
/** Research page — fixed section order from SPEC §4. */
import { render } from 'astro:content';
import DetailLayout from '~/layouts/DetailLayout.astro';
import StatusBadge from '~/components/StatusBadge.astro';
import AuthorList from '~/components/AuthorList.astro';
import LinkRow from '~/components/LinkRow.astro';
import Section from '~/components/Section.astro';
import KeyFindings from '~/components/KeyFindings.astro';
import Citation from '~/components/Citation.astro';
import BibtexButton from '~/components/BibtexButton.astro';
import Card from '~/components/Card.astro';
import PrevNext from '~/components/PrevNext.astro';
import Chip from '~/components/Chip.astro';
import Todo from '~/components/Todo.astro';
import Explainer from '~/components/Explainer.astro';
import PaperCover from '~/components/PaperCover.astro';
import { chapterFor, CHAPTER_LABEL } from '~/lib/chapters';
import MathTex from '~/components/Math.astro';
import Flow from '~/components/Flow.astro';
import DotRank from '~/components/charts/DotRank.astro';
import {
  getResearch,
  getPublic,
  related,
  bibtex,
  dateKey,
  formatDate,
  AREA_LABEL,
  KIND_LABEL,
  type Research,
  yearOf,
} from '~/lib/content';
import { entryPath, topicPath, withBase } from '~/lib/paths';
import { show, visible, isTodo } from '~/lib/todo';
import { SITE } from '~/lib/site';

export async function getStaticPaths() {
  const list = (await getResearch()).sort(
    (a, b) => dateKey(b.data.date).localeCompare(dateKey(a.data.date)) || a.id.localeCompare(b.id),
  );
  return list.map((entry, i) => ({
    params: { slug: entry.id },
    props: { entry, prev: list[i - 1], next: list[i + 1] },
  }));
}

interface Props {
  entry: Research;
  prev?: Research | undefined;
  next?: Research | undefined;
}
const { entry, prev, next } = Astro.props;
const d = entry.data;
const cite = entry.cite;
const { Content, headings } = await render(entry);

const pool = [...(await getResearch()), ...(await getPublic('projects'))];
const rel = related(entry, pool);
const bib = d.doi ? bibtex(d.doi) : undefined;
const findings = visible(d.keyFindings);
const limitations = visible(d.limitations);
const hasCite = !!d.doi || d.status === 'published' || d.status === 'accepted';
const dateLabel = formatDate(d.date);
const chapter = chapterFor(d.areas);

const toc = [
  { id: 'tldr', label: 'TL;DR' },
  ...headings.filter((h) => h.depth === 2).map((h) => ({ id: h.slug, label: h.text })),
  ...(cite.abstract ? [{ id: 'abstract', label: 'Abstract' }] : []),
  ...(findings.length || !import.meta.env.PROD ? [{ id: 'key-findings', label: 'Key findings' }] : []),
  ...(limitations.length || !import.meta.env.PROD ? [{ id: 'limitations', label: 'Limitations & honest notes' }] : []),
  ...(show(d.myRole) ? [{ id: 'my-role', label: 'My role' }] : []),
  ...(hasCite ? [{ id: 'cite', label: 'Cite' }] : []),
  ...(rel.length ? [{ id: 'related', label: 'Related' }] : []),
];

const links = [
  { label: 'Paper', href: d.links.paper },
  { label: 'Preprint', href: d.links.preprint },
  { label: 'PDF', href: d.links.pdf },
  { label: 'Code', href: d.links.code },
  { label: 'Data', href: d.links.data },
  { label: 'Slides', href: d.links.slides },
  { label: 'Poster', href: d.links.poster },
  { label: 'arXiv', href: d.links.arxiv },
  { label: 'BibTeX', href: bib ? '#cite' : undefined },
];

const jsonLd = d.doi
  ? {
      '@context': 'https://schema.org',
      '@type': 'ScholarlyArticle',
      headline: cite.title,
      name: cite.title,
      author: cite.authors.map((a) => ({ '@type': 'Person', name: a })),
      datePublished: cite.year ? String(cite.year) : undefined,
      isPartOf: cite.venue ? { '@type': 'Periodical', name: cite.venue } : undefined,
      identifier: { '@type': 'PropertyValue', propertyID: 'DOI', value: d.doi },
      sameAs: `https://doi.org/${d.doi}`,
      url: new URL(entryPath(entry), Astro.site).href,
      abstract: cite.abstract,
    }
  : undefined;
const description = isTodo(d.summary) ? SITE.description : d.summary;
---

<DetailLayout
  title={cite.title}
  description={description}
  toc={toc}
  type="article"
  jsonLd={jsonLd}
  ogImage={withBase(`/og/research/${entry.id}.png`)}
  chapter={chapter}
  epigraph={`research/${entry.id}`}
>
  <header slot="header" class="grid gap-10 lg:grid-cols-[minmax(0,1fr)_17rem] lg:items-start">
    <div class="max-w-6xl">
      <nav aria-label="Breadcrumb" class="label-mono text-ink-soft">
        <a href={withBase('/')} class="text-ink-soft">
          Atlas
        </a>{' '}
        <span aria-hidden="true">›</span>{' '}
        <a href={withBase('/research/')} class="text-ink-soft">
          Research
        </a>{' '}
        <span aria-hidden="true">›</span> <span class="text-[var(--accent-ink)]">{CHAPTER_LABEL[chapter]}</span>
      </nav>
      <h1 class="mt-5 text-[clamp(2.3rem,1.8rem+2.2vw,3.9rem)]">{cite.title}</h1>
      <div class="mt-5 flex flex-wrap items-center gap-3">
        <StatusBadge status={d.status} />
        <span class="label-mono text-ink-soft">{KIND_LABEL[d.kind]}</span>
        {(cite.venue || cite.year) && (
          <span class="label-mono text-ink-soft">{[cite.venue, cite.year].filter(Boolean).join(' · ')}</span>
        )}
        {!cite.year && dateLabel && <span class="label-mono text-ink-soft">{dateLabel}</span>}
      </div>
      <div class="mt-4">
        <AuthorList authors={cite.authors} />
      </div>
      {d.advisor && <p class="mt-1 text-sm text-ink-soft">Advisor: {d.advisor}</p>}
      {d.doi && (
        <p class="label-mono mt-3 text-ink-soft normal-case">
          DOI <a href={`https://doi.org/${d.doi}`}>{d.doi}</a>
        </p>
      )}
      <div class="mt-6">
        <LinkRow links={links} label="Paper links" />
      </div>
      <ul class="mt-5 flex flex-wrap gap-2" aria-label="Areas">
        {d.areas.map((a) => (
          <li>
            <Chip href={withBase(`/research/?area=${a}`)}>{AREA_LABEL[a]}</Chip>
          </li>
        ))}
      </ul>
    </div>
    <div class="hidden max-w-[17rem] lg:block">
      <PaperCover
        id={entry.id}
        title={cite.title}
        chapter={chapter}
        folio={`R · ${entry.id.slice(0, 18)}`}
        venue={cite.venue}
        year={cite.year ?? yearOf(d.date)}
      />
    </div>
  </header>

  <Section id="tldr" title="TL;DR">
    {show(d.summary) ? <p class="text-lg">{d.summary}</p> : <Todo text={d.summary} />}
  </Section>

  <div class="prose-site mt-12 [&>h2]:scroll-mt-24">
    <Content components={{ Explainer, Todo, Math: MathTex, Flow, DotRank }} />
  </div>

  {cite.abstract && (
    <Section id="abstract" title="Abstract">
      <p class="text-sm text-muted">From the publisher, via Crossref.</p>
      <blockquote>
        <p>{cite.abstract}</p>
      </blockquote>
    </Section>
  )}

  {(findings.length > 0 || !import.meta.env.PROD) && (
    <Section id="key-findings" title="Key findings">
      {findings.length > 0 ? (
        <KeyFindings items={findings} />
      ) : (
        <Todo inline={false}>key findings, each with its source (paper section/table)</Todo>
      )}
    </Section>
  )}

  {(limitations.length > 0 || !import.meta.env.PROD) && (
    <Section id="limitations" title="Limitations & honest notes">
      {limitations.length > 0 ? (
        <ul>
          {limitations.map((l) => (
            <li>{l}</li>
          ))}
        </ul>
      ) : (
        <Todo inline={false}>limitations and honest notes (required section)</Todo>
      )}
    </Section>
  )}

  {show(d.myRole) && (
    <Section id="my-role" title="My role">
      {isTodo(d.myRole) ? <Todo text={d.myRole} /> : <p>{d.myRole}</p>}
    </Section>
  )}

  {hasCite && (
    <Section id="cite" title="Cite">
      <Citation cite={cite} />
      {bib && <BibtexButton bibtex={bib} id={entry.id} />}
    </Section>
  )}

  {d.tags.length > 0 && (
    <ul class="mt-12 flex flex-wrap gap-2" aria-label="Topics">
      {d.tags.map((t) => (
        <li>
          <Chip href={topicPath(t)} size="md">
            #{t}
          </Chip>
        </li>
      ))}
    </ul>
  )}

  {rel.length > 0 && (
    <section aria-labelledby="related" class="mt-12">
      <h2 id="related" class="scroll-mt-24">
        Related
      </h2>
      <ul class="mt-6 grid gap-6 md:grid-cols-2 xl:grid-cols-3" data-reveal-group>
        {rel.map((r) => (
          <li>
            <Card href={entryPath(r)} title={r.data.title} summary={r.data.summary} status={r.data.status} tags={r.data.tags} />
          </li>
        ))}
      </ul>
    </section>
  )}

  <PrevNext
    label="More research"
    prev={prev && { href: entryPath(prev), title: prev.data.title }}
    next={next && { href: entryPath(next), title: next.data.title }}
  />
</DetailLayout>
