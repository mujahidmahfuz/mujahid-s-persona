---
/** About — the person behind the atlas (Website_Redesign.md §11). Facts from bio.ts / content only. */
import BaseLayout from '~/layouts/BaseLayout.astro';
import Epigraph from '~/components/Epigraph.astro';
import Timeline from '~/components/Timeline.astro';
import ActivityChart from '~/components/charts/ActivityChart.astro';
import Todo from '~/components/Todo.astro';
import { SHORT_BIO, LONG_BIO, INTERESTS } from '~/lib/bio';
import { timelineItems } from '~/lib/timeline';
import { show, isTodo } from '~/lib/todo';
import { withBase } from '~/lib/paths';
import { SITE } from '~/lib/site';

const items = await timelineItems();
---

<BaseLayout title="About" description={SHORT_BIO} type="profile">
  <header class="graticule border-b border-rule">
    <div class="container-site py-16 md:py-24">
      <p class="label-mono text-center text-terracotta-ink">Chapter VI · The person</p>
      <h1 class="mt-4 text-center">About</h1>
      <div class="mt-12">
        <Epigraph page="about" treatment="grand" />
      </div>
    </div>
  </header>

  <div class="container-site grid gap-14 py-16 lg:grid-cols-[minmax(0,1fr)_22rem]">
    <div>
      <p class="font-serif text-[clamp(1.5rem,1.25rem+1vw,2.15rem)] leading-snug text-ink">{SHORT_BIO}</p>
      {show(LONG_BIO) && (
        <div class="prose-site mt-8">{isTodo(LONG_BIO) ? <Todo text={LONG_BIO} inline={false} /> : <p>{LONG_BIO}</p>}</div>
      )}
      <p class="mt-8 max-w-4xl text-ink-soft">
        I work at the {SITE.affiliation}. The rest of this atlas is the long version: the{' '}
        <a href={withBase('/research/')}>research</a>, the <a href={withBase('/projects/')}>things I have built</a>, and the{' '}
        <a href={withBase('/sports/')}>pitch</a>.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={withBase('/cv/')} class="paper-action">
          Read the CV
        </a>
        <a href={withBase('/contact/')} class="paper-action">
          Write to me
        </a>
      </div>
    </div>
    <aside class="paper-card self-start rounded-card p-7" aria-labelledby="interests">
      <p class="label-mono text-terracotta-ink">Questions that keep me busy</p>
      <h2 id="interests" class="mt-2 text-h3">
        Research interests
      </h2>
      <ul class="mt-5 space-y-3">
        {INTERESTS.map((i) => (
          <li class="flex gap-3 border-b border-dotted border-rule pb-3 last:border-0">
            <span aria-hidden="true" class="mt-2.5 h-1.5 w-1.5 shrink-0 rotate-45 bg-terracotta" />
            <span class="font-serif text-lg">{i}</span>
          </li>
        ))}
      </ul>
    </aside>
  </div>

  <section class="border-t border-rule bg-paper-light py-16" aria-labelledby="chronology">
    <div class="container-site">
      <p class="label-mono text-terracotta-ink">Archive</p>
      <h2 id="chronology" class="mt-2">
        A chronology
      </h2>
      <p class="mt-3 max-w-4xl text-ink-soft">The same years, seen twice: once as overlapping threads, once as a list.</p>
      <div class="paper-card mt-10 rounded-card p-6">
        <ActivityChart />
      </div>
      <div class="mt-14 max-w-5xl">
        <Timeline items={items} />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .paper-action {
    display: inline-flex;
    border: 1px solid var(--color-ink-soft);
    border-radius: 2px;
    padding: 0.55rem 1rem;
    color: var(--color-ink);
    text-decoration: none;
    font-weight: 600;
  }
  .paper-action:hover {
    border-color: var(--color-verdigris);
    background: var(--color-ivory);
  }
</style>
