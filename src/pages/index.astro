---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { SITE } from '~/lib/site';
---

<BaseLayout title={SITE.name}>
  <section class="bg-blue text-white" data-surface="blue">
    <div class="container-site py-20">
      <h1>
        <span class="accent-underline">{SITE.name}</span>
      </h1>
    </div>
  </section>
</BaseLayout>
