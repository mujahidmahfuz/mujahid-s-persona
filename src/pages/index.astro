---
/**
 * Homepage — "the entrance to the atlas" (Website_Redesign.md §6). Nine movements:
 * opening · epigraph · featured research · workshop · publications · on the desk · ledger ·
 * beyond research · questions & closing. Facts come only from the content collections.
 */
import { Image } from 'astro:assets';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Epigraph from '~/components/Epigraph.astro';
import CelestialInstrument from '~/components/CelestialInstrument.astro';
import HeroObject from '~/components/HeroObject.astro';
import PaperObject from '~/components/PaperObject.astro';
import { journalCover } from '~/lib/journals';
import StatusBadge from '~/components/StatusBadge.astro';
import Card from '~/components/Card.astro';
import { getResearch, getPublic, dateKey, formatDate, formatRange, yearOf, CATEGORY_LABEL } from '~/lib/content';
import { chapterFor, CHAPTER_LABEL } from '~/lib/chapters';
import { entryPath, withBase } from '~/lib/paths';
import { SHORT_BIO } from '~/lib/bio';
import { PROFILES, SITE } from '~/lib/site';
import { show } from '~/lib/todo';
import tiuSeal from '~/assets/sports/tiu-seal.png';

const research = await getResearch();
const projects = await getPublic('projects');
const featuredResearch = research
  .filter((r) => r.data.status !== 'concept')
  .sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || dateKey(b.data.date).localeCompare(dateKey(a.data.date)))
  .slice(0, 3);
// The workshop rail: everything that is built (concepts stay on /projects/), numbers first.
const railProjects = projects
  .filter((p) => p.data.status !== 'concept')
  .sort(
    (a, b) =>
      Number(b.data.featured) - Number(a.data.featured) ||
      b.data.stats.length - a.data.stats.length ||
      b.data.highlights.length - a.data.highlights.length ||
      a.id.localeCompare(b.id),
  );
const publications = research.filter((r) => r.data.doi).sort((a, b) => (b.cite.year ?? 0) - (a.cite.year ?? 0));
const onDesk = [...research, ...projects]
  .filter((e) => e.data.status === 'in-progress' || e.data.status === 'in-preparation')
  .sort((a, b) => a.data.title.localeCompare(b.data.title))
  .slice(0, 6);
const awards = (await getPublic('awards')).sort((a, b) => dateKey(b.data.date).localeCompare(dateKey(a.data.date)));
const sports = (await getPublic('sports'))[0];
const teaching = (await getPublic('experience')).filter((e) => e.data.type === 'ta' || e.data.type === 'sa');

// Questions the work keeps returning to — each paraphrases the linked page's own problem statement.
const find = (id: string) => [...research, ...projects].find((e) => e.id === id);
const QUESTIONS = [
  {
    q: 'How can an explanation stay steady when there are far fewer examples than features?',
    id: 'bwa-bootstrap-wasserstein-alignment',
  },
  { q: 'When should a learning machine sleep — and how often is enough?', id: 'sleep-continual-learning' },
  { q: 'Could a photonic quantum computer that tracks its own losses tolerate more of them?', id: 'lossmap-photonic-loss' },
  { q: 'Is a council of models, judging each other blind, better than any one of them?', id: 'llm-council' },
  { q: 'How little memory can a post-quantum signature live in?', id: 'pqc-arduino' },
]
  .map((x) => ({ ...x, entry: find(x.id) }))
  .filter((x) => x.entry);

const CONTENTS = [
  { n: 'I', label: 'Research', href: '/research/', note: `${research.length} studies` },
  { n: 'II', label: 'Projects', href: '/projects/', note: `${projects.length} things made` },
  { n: 'III', label: 'Publications', href: '/publications/', note: `${publications.length} papers` },
  { n: 'IV', label: 'Achievements', href: '/achievements/', note: `${awards.length} entries` },
  { n: 'V', label: 'Sports', href: '/sports/', note: 'the pitch' },
  { n: 'VI', label: 'About', href: '/about/', note: 'the person' },
];

const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.name,
  alternateName: SITE.shortName,
  url: new URL(withBase('/'), SITE.url).href,
  jobTitle: 'Undergraduate Researcher',
  affiliation: { '@type': 'Organization', name: SITE.affiliation },
  alumniOf: { '@type': 'CollegeOrUniversity', name: SITE.university },
  knowsAbout: ['Explainable AI', 'Continual learning', 'Quantum computing', 'Quantum machine learning'],
  sameAs: PROFILES.map((p) => p.href),
  identifier: { '@type': 'PropertyValue', propertyID: 'ORCID', value: SITE.orcidId },
};
---

<BaseLayout title={SITE.name} description={SHORT_BIO} jsonLd={person} type="profile">
  <!-- 1 · Opening -->
  <section class="graticule relative overflow-hidden" aria-labelledby="hero-title" data-tilt-zone>
    <div class="container-site grid items-center gap-10 py-14 md:py-20 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
      <div class="relative">
        <h1 id="hero-title" class="text-[clamp(3rem,2.2rem+3.4vw,5.6rem)] leading-[0.95] font-bold">
          Who AM I?
        </h1>
        <p class="mt-7 max-w-3xl font-serif text-[clamp(1.35rem,1.15rem+0.8vw,1.85rem)] leading-snug text-ink italic">
          Somewhere in Tokyo, between everyday routines, late-night thoughts, and walks with nowhere in particular to go, I find
          myself navigating undergraduate life while chasing questions that rarely stay within the classroom.
        </p>
        <p class="mt-6 max-w-3xl text-[1.08rem] text-ink">
          I am <strong class="font-semibold text-verdigris">Md Mujahidul Islam</strong>, usually Muja — an independent researcher
          exploring explainable AI, continual learning, and quantum information. Outside research, I enjoy football, building
          things, wandering through unfamiliar places, and getting lost in thoughts about life, science, and everything in
          between.
        </p>
        <nav aria-label="Contents" class="mt-10 max-w-3xl">
          <p class="label-mono text-ink-soft">Contents</p>
          <ol class="mt-3 divide-y divide-rule border-y border-rule">
            {CONTENTS.map((c) => (
              <li>
                <a href={withBase(c.href)} class="contents-row group flex items-baseline gap-4 py-2.5 text-ink no-underline">
                  <span class="label-mono w-8 text-terracotta-ink">{c.n}</span>
                  <span class="font-serif text-xl font-semibold text-verdigris group-hover:underline">{c.label}</span>
                  <span class="contents-leader flex-1 border-b border-dotted border-rule" aria-hidden="true" />
                  <span class="label-mono text-ink-soft normal-case">{c.note}</span>
                </a>
              </li>
            ))}
          </ol>
        </nav>
      </div>
      <div class="mx-auto w-full max-w-[40rem]">
        <HeroObject tilt={4}>
          <CelestialInstrument />
        </HeroObject>
        <p class="label-mono mt-3 text-center text-ink-soft normal-case">
          Six chapters of work — the markers grow with what each holds. Choose one to begin.
        </p>
      </div>
    </div>
  </section>

  <!-- 2 · Epigraph, at dusk -->
  <section class="surface-dark py-16 md:py-24" data-surface="dark" aria-label="Epigraph">
    <div class="container-site">
      <Epigraph page="home" treatment="grand" onDark />
    </div>
  </section>

  <!-- 3 · Featured research — an editorial list -->
  <section class="container-site py-20" aria-labelledby="featured-research">
    <div class="flex flex-wrap items-end justify-between gap-4 border-b border-rule pb-4">
      <div>
        <p class="label-mono text-terracotta-ink">Chapter I</p>
        <h2 id="featured-research" class="mt-2">
          What I am trying to understand
        </h2>
      </div>
      <a href={withBase('/research/')} class="font-semibold">
        All research <span aria-hidden="true">→</span>
      </a>
    </div>
    <ul class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3" data-reveal-group>
      {featuredResearch.map((r) => {
        const jc = journalCover(r.cite?.venue);
        return (
          <li data-chapter={chapterFor(r.data.areas)}>
            <Card
              variant="research"
              href={entryPath(r)}
              title={r.data.title}
              summary={r.data.summary}
              status={r.data.status}
              tags={r.data.tags}
              meta={[CHAPTER_LABEL[chapterFor(r.data.areas)], r.cite.venue, r.cite.year ?? yearOf(r.data.date)]
                .filter(Boolean)
                .join(' · ')}
            >
              {jc && (
                <Image
                  slot="cover-inset"
                  src={jc.src}
                  alt={jc.alt}
                  height={150}
                  class="h-full w-auto rounded-[2px] shadow-[0_6px_14px_-6px_rgba(23,54,61,0.6)]"
                />
              )}
              {jc && (
                <p class="label-mono text-[0.6rem] text-ink-soft">Journal cover · © {jc.publisher} · representative issue</p>
              )}
            </Card>
          </li>
        );
      })}
    </ul>
  </section>

  <!-- 4 · The workshop -->
  <section class="hero-plate relative overflow-hidden py-20 md:py-24" data-surface="dark" aria-labelledby="workshop">
    <div class="container-site">
      <div class="grid gap-6 md:grid-cols-[1fr_1.2fr] md:items-end">
        <div>
          <p class="label-mono text-saffron-light">Chapter II</p>
          <h2 id="workshop" class="mt-2 text-[clamp(2.4rem,1.8rem+2.4vw,4rem)]">
            The workshop
          </h2>
        </div>
        <p class="max-w-3xl text-ivory/85 md:justify-self-end">
          Things I have built to see whether an idea survives contact with reality — with the numbers they produced, and a status
          that says how far each one got. Scroll sideways for more.
        </p>
      </div>
    </div>
    <div class="relative mt-10">
      <ul class="rail flex gap-5 overflow-x-auto px-(--rail-pad) pb-6" aria-label="Projects" data-rail data-reveal-group>
        {railProjects.map((p) => {
          const top = p.data.stats[0];
          return (
            <li class="w-[min(86vw,26rem)] shrink-0" data-chapter={chapterFor(p.data.areas)}>
              <article
                class="rail-panel relative flex h-full min-h-[27rem] flex-col rounded-card border border-ivory/20 bg-ivory/[0.05] p-6 md:p-7"
                data-spotlight
              >
                <div class="flex flex-wrap items-center gap-2">
                  <StatusBadge status={p.data.status} />
                  <span class="label-mono text-ivory/75">{CATEGORY_LABEL[p.data.category]}</span>
                </div>
                <h3 class="mt-5 text-[2rem] leading-[1.05]">
                  <a href={entryPath(p)} class="no-underline after:absolute after:inset-0">
                    {p.data.title}
                  </a>
                </h3>
                <p class="mt-3 line-clamp-4 text-[0.95rem] text-ivory/85">{p.data.summary}</p>
                {top && (
                  <p class="mt-auto border-t border-ivory/20 pt-5">
                    <span class="stat-value block text-[2.6rem] text-ivory" data-countup>
                      {top.value}
                    </span>
                    <span class="mt-1 block text-sm text-ivory/80">{top.label}</span>
                  </p>
                )}
                <p class:list={['flex items-center justify-between gap-3 pt-5 text-sm', !top && 'mt-auto']}>
                  <span class="truncate text-ivory/75">{p.data.stack.slice(0, 3).join(' · ')}</span>
                  <span class="shrink-0 font-semibold text-saffron-light" aria-hidden="true">
                    Explore <span class="rail-arrow">→</span>
                  </span>
                </p>
              </article>
            </li>
          );
        })}
      </ul>
    </div>
    <div class="container-site mt-4 flex flex-wrap items-center justify-between gap-4">
      <div class="js-only flex gap-2" aria-hidden="true">
        <button
          type="button"
          class="rounded-chip border border-ivory/45 px-4 py-2 text-ivory hover:border-ivory"
          data-rail-step="-1"
          tabindex="-1"
        >
          ←
        </button>
        <button
          type="button"
          class="rounded-chip border border-ivory/45 px-4 py-2 text-ivory hover:border-ivory"
          data-rail-step="1"
          tabindex="-1"
        >
          →
        </button>
      </div>
      <a href={withBase('/projects/')} class="font-semibold" data-magnetic>
        Everything in the workshop <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <!-- 5 · Publications -->
  <section class="container-site py-20" aria-labelledby="library">
    <p class="label-mono text-terracotta-ink">Chapter III</p>
    <h2 id="library" class="mt-2">
      From the library
    </h2>
    <p class="mt-3 max-w-4xl text-ink-soft">Work that has passed peer review and found a home in a journal.</p>
    <div class="mt-10 grid gap-12 xl:grid-cols-2">
      {publications.map((p, i) => (
        <PaperObject entry={p} folio={`P-${String(i + 1).padStart(2, '0')}`} compact />
      ))}
    </div>
  </section>

  <!-- 6 · On the desk -->
  <section class="border-y border-rule py-16" aria-labelledby="desk">
    <div class="container-site grid gap-10 md:grid-cols-[18rem_1fr]">
      <div>
        <p class="label-mono text-terracotta-ink">Current explorations</p>
        <h2 id="desk" class="mt-2 text-[clamp(1.7rem,1.4rem+1vw,2.3rem)]">
          On the desk now
        </h2>
        <p class="mt-3 text-sm text-ink-soft">
          Unfinished, and labelled as such. Some will become papers; some will become lessons.
        </p>
      </div>
      <ul class="grid gap-x-10 sm:grid-cols-2" data-reveal-group>
        {onDesk.map((e) => (
          <li class="flex items-baseline gap-3 border-b border-dotted border-rule py-3" data-chapter={chapterFor(e.data.areas)}>
            <span class="mt-1 inline-block h-2.5 w-2.5 shrink-0 rounded-full bg-[var(--accent)]" aria-hidden="true" />
            <span class="min-w-0">
              <a href={entryPath(e)} class="font-serif text-lg font-semibold text-verdigris no-underline hover:underline">
                {e.data.title}
              </a>
              <span class="label-mono block text-ink-soft normal-case">
                {e.data.status.replace('-', ' ')} · {CHAPTER_LABEL[chapterFor(e.data.areas)]}
              </span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 7 · A ledger of achievements -->
  <section class="container-site py-20" aria-labelledby="ledger">
    <div class="grid gap-10 md:grid-cols-[1fr_1.4fr]">
      <div>
        <p class="label-mono text-terracotta-ink">Chapter IV</p>
        <h2 id="ledger" class="mt-2">
          A short ledger
        </h2>
        <p class="mt-3 max-w-sm text-ink-soft">
          Not a scoreboard — a few moments that marked the way, with their context on each page.
        </p>
        <a href={withBase('/achievements/')} class="mt-5 inline-block font-semibold">
          The full ledger <span aria-hidden="true">→</span>
        </a>
      </div>
      <ol class="border-t-2 border-ink" data-reveal-group>
        {awards.map((a) => (
          <li class="grid grid-cols-[5.5rem_1fr] gap-4 border-b border-rule py-4">
            <span class="label-mono pt-1 text-ink-soft">{formatDate(a.data.date) ?? '—'}</span>
            <span>
              <a href={entryPath(a)} class="font-serif text-xl font-semibold text-verdigris no-underline hover:underline">
                {a.data.title}
              </a>
              {show(a.data.description) && <span class="mt-1 block text-sm text-ink-soft">{a.data.description}</span>}
            </span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 8 · Beyond research -->
  <section class="bg-petrol py-20 text-ivory" data-surface="dark" aria-labelledby="beyond">
    <div class="container-site">
      <p class="label-mono text-saffron-light">Chapter V</p>
      <h2 id="beyond" class="mt-2">
        Beyond the desk
      </h2>
      <div class="mt-10 grid gap-10 md:grid-cols-2">
        {sports && (
          <article class="flex gap-6" data-reveal>
            <span class="shrink-0 self-start rounded-md bg-ivory p-2">
              <Image src={tiuSeal} alt="Tokyo International University seal" width={88} height={88} class="h-[88px] w-[88px]" />
            </span>
            <div>
              <p class="label-mono text-saffron-light">On the pitch · {formatRange(sports.data.start, sports.data.end)}</p>
              <h3 class="mt-2 text-2xl">
                <a href={entryPath(sports)}>{sports.data.team}</a>
              </h3>
              <p class="mt-2 text-ivory/90">
                {sports.data.sport} for {sports.data.org}, in the {sports.data.leagues.join(' and the ')}. A different kind of
                discipline: ninety minutes, eleven people, no undo.
              </p>
            </div>
          </article>
        )}
        <article data-reveal>
          <p class="label-mono text-saffron-light">In the classroom</p>
          <h3 class="mt-2 text-2xl">Teaching, and being taught by it</h3>
          <ul class="mt-3 space-y-2 text-ivory/90">
            {teaching.map((t) => (
              <li>
                <a href={entryPath(t)}>{t.data.course ? `${t.data.role} — ${t.data.course}` : t.data.role}</a>
                <span class="label-mono ml-2 text-ivory/80 normal-case">{formatRange(t.data.start, t.data.end)}</span>
                {t.data.supervisor && (
                  <span class="block text-sm text-ivory/85">
                    with{' '}
                    {t.data.supervisorUrl ? (
                      <a href={t.data.supervisorUrl} rel="noopener">
                        {t.data.supervisor}
                      </a>
                    ) : (
                      t.data.supervisor
                    )}
                  </span>
                )}
              </li>
            ))}
          </ul>
        </article>
      </div>
    </div>
  </section>

  <!-- 9 · Questions, then the door -->
  <section class="container-site py-20" aria-labelledby="questions">
    <p class="label-mono text-terracotta-ink">Personal reflections</p>
    <h2 id="questions" class="mt-2">
      Questions I keep coming back to
    </h2>
    <ol class="mt-8 max-w-6xl" data-reveal-group>
      {QUESTIONS.map((x, i) => (
        <li class="flex gap-5 border-b border-rule py-5" data-chapter={chapterFor(x.entry!.data.areas)}>
          <span class="label-mono pt-2 text-[var(--accent-ink)]">Q{i + 1}</span>
          <a
            href={entryPath(x.entry!)}
            class="font-serif text-[clamp(1.35rem,1.15rem+0.7vw,1.85rem)] leading-snug text-ink italic no-underline hover:underline"
          >
            {x.q}
          </a>
        </li>
      ))}
    </ol>
    <div class="paper-card mt-16 grid gap-6 rounded-card p-8 md:grid-cols-[1fr_auto] md:items-center md:p-10" data-reveal>
      <div>
        <p class="font-serif text-[clamp(1.6rem,1.3rem+1vw,2.3rem)] leading-tight text-verdigris">
          If any of these questions are yours too, write to me.
        </p>
        <p class="mt-2 text-ink-soft">Collaborations, corrections and good arguments are all welcome.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href={withBase('/contact/')} class="paper-cta is-primary">
          Begin a conversation
        </a>
        <a href={withBase('/cv/')} class="paper-cta">
          Read the CV
        </a>
      </div>
    </div>
  </section>
  <script>
    // Rail arrows (mouse convenience; the rail itself scrolls natively and by keyboard/touch).
    document.querySelectorAll<HTMLButtonElement>('[data-rail-step]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const rail = document.querySelector<HTMLElement>('[data-rail]');
        const card = rail?.querySelector<HTMLElement>('li');
        if (!rail || !card) return;
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        rail.scrollBy({ left: Number(btn.dataset.railStep) * (card.offsetWidth + 20), behavior: reduce ? 'auto' : 'smooth' });
      });
    });
  </script>
</BaseLayout>

<style>
  @media (hover: hover) and (pointer: fine) {
    .contents-row:hover .contents-leader {
      border-bottom-color: var(--color-terracotta);
    }
  }
  .paper-cta {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--color-verdigris);
    border-radius: 2px;
    padding: 0.7rem 1.2rem;
    font-weight: 600;
    color: var(--color-verdigris);
    text-decoration: none;
    transition:
      background-color 150ms var(--ease-out),
      transform 120ms var(--ease-out);
  }
  .paper-cta:hover {
    background: var(--color-paper-light);
  }
  .paper-cta.is-primary {
    background: var(--color-verdigris);
    color: var(--color-ivory);
  }
  .paper-cta.is-primary:hover {
    background: var(--color-petrol);
  }
  .paper-cta:active {
    transform: scale(0.98);
  }
</style>
